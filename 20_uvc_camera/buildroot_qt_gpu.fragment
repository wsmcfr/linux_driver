# Buildroot Qt/GPU 用户态配置片段。
# 作用：
#   为 STM32MP157 Qt Quick 摄像头界面启用 Qt5 runtime、Qt Multimedia、
#   eglfs/wayland 平台插件、gcnano EGL/GLES 用户态库和 GStreamer 摄像头后端。
#
# 合并示例：
#   cd /home/cfr/linux/buildroot/buildroot-2020.02.6
#   ./support/kconfig/merge_config.sh output-uvc/.config /home/cfr/linux/Linux_Drivers/20_uvc_camera/buildroot_qt_gpu.fragment
#   make O=/home/cfr/linux/buildroot/buildroot-2020.02.6/output-uvc olddefconfig
#
# 注意：
#   当前工程的 Buildroot 没有启用 BR2_LINUX_KERNEL 时，gcnano-binaries 可能会被
#   olddefconfig 自动裁掉。此时先使用 qt_camera_display/install_qt_runtime_from_sdk.sh
#   从 ST Qt/Wayland SDK 复制运行库到 rootfs，后续再整理完整 Buildroot defconfig。

BR2_PACKAGE_GCNANO_BINARIES=y

BR2_PACKAGE_QT5=y
BR2_PACKAGE_QT5BASE_GUI=y
BR2_PACKAGE_QT5BASE_OPENGL=y
BR2_PACKAGE_QT5BASE_OPENGL_ES2=y
BR2_PACKAGE_QT5BASE_EGLFS=y
BR2_PACKAGE_QT5BASE_DEFAULT_QPA="eglfs"
BR2_PACKAGE_QT5BASE_FONTCONFIG=y
BR2_PACKAGE_QT5BASE_HARFBUZZ=y
BR2_PACKAGE_QT5BASE_JPEG=y
BR2_PACKAGE_QT5BASE_PNG=y
BR2_PACKAGE_QT5DECLARATIVE=y
BR2_PACKAGE_QT5DECLARATIVE_QUICK=y
BR2_PACKAGE_QT5MULTIMEDIA=y
BR2_PACKAGE_QT5WAYLAND=y

BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_WAYLAND_PROTOCOLS=y

BR2_PACKAGE_GSTREAMER1=y
BR2_PACKAGE_GSTREAMER1_PARSE=y
BR2_PACKAGE_GSTREAMER1_PLUGIN_REGISTRY=y
BR2_PACKAGE_GSTREAMER1_INSTALL_TOOLS=y
BR2_PACKAGE_GST1_PLUGINS_BASE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_APP=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_TYPEFIND=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_PLAYBACK=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOCONVERT=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOSCALE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL=y
BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_GLES2=y
BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_EGL=y
BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_WAYLAND=y
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_JPEG=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2_PROBE=y
BR2_PACKAGE_GST1_PLUGINS_BAD=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_CAMERABIN2=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_GL=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_WAYLAND=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_FBDEV=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_KMS=y

BR2_PACKAGE_DEJAVU=y
BR2_PACKAGE_DEJAVU_SANS=y
