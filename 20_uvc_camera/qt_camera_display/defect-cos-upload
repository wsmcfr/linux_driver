#!/bin/sh
#
# 作用：
#   把 Qt 检测任务生成的原图和检测结果图片上传到云端 COS，并登记到同一条检测记录。
#
# 主要流程：
#   1. 校验 --jpg 原图和一个或多个 --annotated 结果图已经存在且非空。
#   2. 先读取板端本地默认账号配置，再使用后端登录 Cookie 调用云端 API；
#      Cookie 缺失时可用 CLOUD_ACCOUNT/CLOUD_PASSWORD 登录。
#   3. 创建检测记录，再为 JPG(source) 和每张结果图(annotated) 申请 COS 预签名上传地址。
#   4. 使用 curl PUT 上传到 COS，并把 ETag、对象路径和文件大小登记回检测记录。
#
# 返回值：
#   全部上传和登记成功返回 0；任一步失败返回非 0，并在 stderr 输出可排查原因。

set -eu

# CLOUD_UPLOAD_ENV_FILE 是板端本地私有配置文件路径，用来保存默认上传账号。
# 这个文件不进入 Git；部署或板端手工写入时应设置为 600 权限。
CLOUD_UPLOAD_ENV_FILE="${CLOUD_UPLOAD_ENV_FILE:-/root/qt_camera_display/cos-upload.env}"

# 这些 *_OVERRIDE 变量记录调用者显式传入的运行时覆盖值。
# 后面读取 cos-upload.env 后会把非空覆盖值恢复回来，使“本地配置”只作为默认值。
CLOUD_BASE_URL_OVERRIDE="${CLOUD_BASE_URL:-}"
CLOUD_COOKIE_FILE_OVERRIDE="${CLOUD_COOKIE_FILE:-}"
CLOUD_ACCOUNT_OVERRIDE="${CLOUD_ACCOUNT:-}"
CLOUD_PASSWORD_OVERRIDE="${CLOUD_PASSWORD:-}"
CLOUD_DEVICE_ID_OVERRIDE="${CLOUD_DEVICE_ID:-}"
CLOUD_PART_ID_OVERRIDE="${CLOUD_PART_ID:-}"
CLOUD_PART_CODE_OVERRIDE="${CLOUD_PART_CODE:-}"
CLOUD_PART_NAME_OVERRIDE="${CLOUD_PART_NAME:-}"
CLOUD_PART_CATEGORY_OVERRIDE="${CLOUD_PART_CATEGORY:-}"
CLOUD_CLASS_LABEL_OVERRIDE="${CLOUD_CLASS_LABEL:-}"
CLOUD_RESULT_OVERRIDE="${CLOUD_RESULT:-}"
CLOUD_HEALTH_URL_OVERRIDE="${CLOUD_HEALTH_URL:-}"
CLOUD_TIME_TZ_OVERRIDE="${CLOUD_TIME_TZ:-}"
CLOUD_TIME_OFFSET_OVERRIDE="${CLOUD_TIME_OFFSET:-}"
CLOUD_TIME_NOW_CMD_OVERRIDE="${CLOUD_TIME_NOW_CMD:-}"
SOURCE_HEADERS_OVERRIDE="${SOURCE_HEADERS:-}"
ANNOTATED_HEADERS_OVERRIDE="${ANNOTATED_HEADERS:-}"

# jpg_file 保存命令行传入的原始检测图路径，云端登记为 source。
jpg_file=""

# ANNOTATED_FILES 保存命令行传入的一组检测结果图路径，云端统一登记为 annotated。
# 这里使用换行分隔，避免后续 UNet overlay/mask 等路径列表互相覆盖。
ANNOTATED_FILES=""

show_usage()
{
    echo "用法：$0 --jpg /mnt/sdcard/images/raw.jpg --annotated /mnt/sdcard/images/overlay.jpg [--annotated /mnt/sdcard/images/mask.png]" >&2
    echo "兼容：$0 --jpg /mnt/sdcard/images/raw.jpg --png /mnt/sdcard/images/old-result.png" >&2
    echo "自检：$0 --self-test-json-parser | --self-test-args" >&2
}

fail()
{
    echo "上传失败：$*" >&2
    exit 1
}

load_upload_env_file()
{
    # 读取板端本地默认上传账号配置。
    # 这样检测按钮不需要每次通过命令行传入账号密码，源码中也不会硬编码真实凭据。
    if [ ! -e "$CLOUD_UPLOAD_ENV_FILE" ]; then
        return 0
    fi

    # 文件存在但不可读时直接报错，避免用户以为已经配置账号却仍然走到登录失败。
    if [ ! -r "$CLOUD_UPLOAD_ENV_FILE" ]; then
        fail "默认上传账号配置不可读：$CLOUD_UPLOAD_ENV_FILE"
    fi

    # 本配置文件只应由 root 维护，内容格式为 POSIX shell 变量赋值。
    # shellcheck disable=SC1090
    . "$CLOUD_UPLOAD_ENV_FILE"
}

json_escape()
{
    # 这个函数只处理本脚本生成的短字符串，主要转义反斜杠和双引号，避免 JSON 被路径或账号破坏。
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'
}

extract_json_string()
{
    # 轻量提取顶层字符串字段；当前后端响应字段稳定，避免在板端额外依赖 jq。
    field="$1"
    file="$2"
    sed -n 's/.*"'"$field"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$file" | head -n 1
}

extract_json_number()
{
    # 轻量提取第一个数字字段，用于零件/设备列表里第一个可用对象的 id。
    # 注意：创建检测记录响应不能用这个通用函数，因为响应后面还会带 part.id/device.id。
    field="$1"
    file="$2"
    tr ',{}[]' '\n\n\n\n\n' < "$file" \
        | sed -n 's/^[[:space:]]*"'"$field"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        | head -n 1
}

json_items_as_lines()
{
    # json_items_as_lines 的作用：
    #   把云端列表响应里的对象粗略拆成一行一个对象，方便在 BusyBox 环境里按零件字段匹配。
    # 主要流程：
    #   1. 删除换行，避免格式化 JSON 影响后续正则。
    #   2. 在相邻对象 `},{` 中间插入换行。
    #   3. 去掉列表响应头尾的方括号噪声，只保留每个对象所在行。
    # 参数：
    #   $1：保存云端列表 JSON 的文件路径。
    # 返回值：
    #   stdout 输出若干行，每行尽量是一条零件对象。
    file="$1"
    tr -d '\r\n' < "$file" \
        | sed 's/},{/}\
{/g' \
        | sed -n '/"id"[[:space:]]*:[[:space:]]*[0-9][0-9]*/p'
}

json_value_from_object_line()
{
    # json_value_from_object_line 的作用：
    #   从单行 JSON 对象里提取一个简单字符串或数字字段。
    # 主要流程：
    #   1. 先尝试匹配字符串字段，例如 part_code/name/category。
    #   2. 匹配不到字符串时再尝试匹配数字字段，例如 id。
    # 参数：
    #   $1：单行 JSON 对象。
    #   $2：字段名。
    # 返回值：
    #   stdout 输出字段值；匹配不到时输出空字符串。
    object_line="$1"
    field="$2"

    printf '%s\n' "$object_line" \
        | tr ',{}[]' '\n\n\n\n\n' \
        | sed -n 's/^[[:space:]]*"'"$field"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        | head -n 1

    printf '%s\n' "$object_line" \
        | tr ',{}[]' '\n\n\n\n\n' \
        | sed -n 's/^[[:space:]]*"'"$field"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        | head -n 1
}

normalize_part_match_key()
{
    # normalize_part_match_key 的作用：
    #   把分类标签、零件编码、零件名称归一化成便于比较的短键。
    # 主要流程：
    #   1. 统一转小写。
    #   2. 去掉空格、横线、下划线等分隔符，让 `PART-WASHER`、`part_washer` 可匹配。
    # 参数：
    #   $1：待归一化文本。
    # 返回值：
    #   stdout 输出归一化后的键。
    printf '%s' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | sed 's/[^a-z0-9]//g'
}

class_label_to_part_code()
{
    # class_label_to_part_code 的作用：
    #   把分类模型输出的 class 标签转换成云端零件类型候选编码。
    # 主要流程：
    #   1. 如果显式传入 CLOUD_PART_CODE，直接使用它。
    #   2. 否则使用 CLOUD_CLASS_LABEL，并去掉常见的 `_good/_bad/-good/-bad` 好坏后缀。
    #   3. 只输出零件类型本身，例如 `gasket_good` 输出 `gasket`。
    # 参数：
    #   无显式参数；读取 CLOUD_PART_CODE 和 CLOUD_CLASS_LABEL。
    # 返回值：
    #   stdout 输出零件类型候选；两者都为空时输出空字符串。
    candidate="${CLOUD_PART_CODE:-}"

    if [ -z "$candidate" ]; then
        candidate="${CLOUD_CLASS_LABEL:-}"
    fi

    if [ -z "$candidate" ]; then
        return 0
    fi

    printf '%s\n' "$candidate" \
        | sed 's/\([_-]\)\([Gg][Oo][Oo][Dd]\|[Bb][Aa][Dd]\)$//'
}

part_matches_candidate()
{
    # part_matches_candidate 的作用：
    #   判断云端一条零件对象是否匹配板端传入的零件类型候选。
    # 主要流程：
    #   1. 优先用 part_code 精确匹配。
    #   2. 再用 part_code/name/category 的归一化结果匹配分类标签去掉好坏后缀后的值。
    #   3. 兼容云端编码写成 `PART-GASKET`、`gasket` 或名称写成 `gasket` 的情况。
    # 参数：
    #   $1：单行零件对象 JSON。
    #   $2：板端零件类型候选。
    # 返回值：
    #   匹配返回 0；不匹配返回 1。
    part_line="$1"
    candidate="$2"
    candidate_key="$(normalize_part_match_key "$candidate")"
    candidate_without_part_prefix="$(printf '%s\n' "$candidate_key" | sed 's/^part//')"

    part_code="$(json_value_from_object_line "$part_line" "part_code")"
    part_name="$(json_value_from_object_line "$part_line" "name")"
    part_category="$(json_value_from_object_line "$part_line" "category")"
    part_code_key="$(normalize_part_match_key "$part_code")"
    part_name_key="$(normalize_part_match_key "$part_name")"
    part_category_key="$(normalize_part_match_key "$part_category")"
    part_code_without_part_prefix="$(printf '%s\n' "$part_code_key" | sed 's/^part//')"

    if [ -z "$candidate_key" ]; then
        return 1
    fi

    if [ "$part_code_key" = "$candidate_key" ] \
        || [ "$part_name_key" = "$candidate_key" ] \
        || [ "$part_category_key" = "$candidate_key" ]; then
        return 0
    fi

    if [ -n "$candidate_without_part_prefix" ] \
        && { [ "$part_code_key" = "$candidate_without_part_prefix" ] \
             || [ "$part_code_without_part_prefix" = "$candidate_without_part_prefix" ] \
             || [ "$part_name_key" = "$candidate_without_part_prefix" ] \
             || [ "$part_category_key" = "$candidate_without_part_prefix" ]; }; then
        return 0
    fi

    return 1
}

extract_part_id_by_code()
{
    # extract_part_id_by_code 的作用：
    #   从 `GET /api/v1/parts?limit=100` 响应中按板端零件类型候选找到云端 part_id。
    # 主要流程：
    #   1. 遍历 items 中的每个零件对象。
    #   2. 对 part_code/name/category 做精确或归一化匹配。
    #   3. 返回第一条匹配零件的 id。
    # 参数：
    #   $1：零件列表 JSON 文件路径。
    #   $2：板端零件类型候选。
    # 返回值：
    #   stdout 输出匹配到的 id；匹配不到时输出空字符串。
    file="$1"
    candidate="$2"

    json_items_as_lines "$file" | while IFS= read -r part_line; do
        [ -n "$part_line" ] || continue

        if part_matches_candidate "$part_line" "$candidate"; then
            part_id="$(json_value_from_object_line "$part_line" "id")"
            if is_positive_number "$part_id"; then
                printf '%s\n' "$part_id"
                break
            fi
        fi
    done | head -n 1
}

record_response_top_level_fields()
{
    # record_response_top_level_fields 的作用：
    #   只保留创建记录响应中进入 part/device/files 嵌套对象之前的顶层字段。
    # 主要流程：
    #   1. 从第一个 part、device 或 files 关系字段开始截断响应，避开嵌套对象里的 id。
    #   2. 把逗号和花括号拆成多行，方便后续用行首匹配读取顶层字段。
    # 参数：
    #   file：保存创建记录响应 JSON 的文件路径。
    # 返回值：
    #   输出拆行后的顶层字段片段。
    file="$1"
    sed 's/"part"[[:space:]]*:.*//; s/"device"[[:space:]]*:.*//; s/"files"[[:space:]]*:.*//' "$file" \
        | tr ',{}[]' '\n\n\n\n\n'
}

extract_created_record_id()
{
    # extract_created_record_id 的作用：
    #   专门解析 POST /api/v1/records 创建记录响应里的顶层检测记录 id。
    # 主要流程：
    #   1. 先截掉 part/device/files 等嵌套关系字段。
    #   2. 再从剩余顶层字段里读取 id，避免把旧零件/旧设备 id 当成 record_id。
    # 参数：
    #   file：保存创建记录响应 JSON 的文件路径。
    # 返回值：
    #   成功时输出顶层 record_id；匹配不到时不输出。
    file="$1"
    record_response_top_level_fields "$file" \
        | sed -n 's/^[[:space:]]*"id"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        | head -n 1
}

extract_created_record_no()
{
    # extract_created_record_no 的作用：
    #   专门解析 POST /api/v1/records 创建记录响应里的顶层 record_no。
    # 主要流程：
    #   只从响应开头的顶层 id + record_no 结构中取记录编号，不从嵌套对象里猜测路径。
    # 参数：
    #   file：保存创建记录响应 JSON 的文件路径。
    # 返回值：
    #   成功时输出云端确认的 record_no；匹配不到时不输出。
    file="$1"
    record_response_top_level_fields "$file" \
        | sed -n 's/^[[:space:]]*"record_no"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        | head -n 1
}

is_positive_number()
{
    # is_positive_number 的作用：
    #   检查传入值是不是大于 0 的十进制数字，防止空值、0、旧字符串继续进入上传链路。
    # 参数：
    #   $1：待检查的字符串。
    # 返回值：
    #   是正整数返回 0；否则返回 1。
    value="$1"

    case "$value" in
        ""|*[!0-9]*|0)
            return 1
            ;;
        *)
            return 0
            ;;
    esac
}

iso8601_local_now()
{
    # iso8601_local_now 的作用：
    #   生成带本地时区偏移的 ISO-8601 时间，避免云端把无时区时间当成另一种时区显示。
    # 主要流程：
    #   1. 直接读取板端当前墙钟时间，不再通过 TZ 二次换算。
    #   2. 给墙钟时间追加 CLOUD_TIME_OFFSET，默认 +08:00，明确告诉后端这是北京时间。
    #   3. CLOUD_TIME_NOW_CMD 只供自检注入固定 date 命令，正常运行不要设置。
    # 返回值：
    #   输出类似 2026-05-08T13:07:02+08:00 的时间字符串。
    if [ -n "$CLOUD_TIME_NOW_CMD" ]; then
        wall_clock="$($CLOUD_TIME_NOW_CMD '+%Y-%m-%dT%H:%M:%S')"
    else
        wall_clock="$(date '+%Y-%m-%dT%H:%M:%S')"
    fi

    printf '%s%s\n' "$wall_clock" "$CLOUD_TIME_OFFSET"
}

log_upload_step()
{
    # log_upload_step 的作用：
    #   把 record_no、record_id、prepare object_key、登记 URL 等关键链路信息打到板端日志。
    # 参数：
    #   $1：已经格式化好的日志文本。
    # 返回值：
    #   只写 stderr，不影响 stdout 最后一行“上传成功：...”给 Qt 状态栏读取。
    printf '%s\n' "$1" >&2
}

extract_etag_header()
{
    # COS 返回头通常是 ETag: "xxxx"，登记时只需要把这一行的值转回 JSON 字符串。
    header_file="$1"
    sed -n 's/^[Ee][Tt][Aa][Gg]:[[:space:]]*\(.*\)[[:space:]]*$/\1/p' "$header_file" | tr -d '\r' | head -n 1
}

run_json_parser_self_test()
{
    # run_json_parser_self_test 的作用：
    #   在不访问网络的情况下复现云端创建记录响应里“顶层 id 是新记录、嵌套 id 是旧零件/设备”的解析场景。
    # 主要流程：
    #   1. 写入一份模拟后端响应，顶层记录 id=8，后面的 part/device id=3。
    #   2. 调用当前脚本使用的 JSON 数字解析函数。
    #   3. 断言解析结果必须是顶层记录 id=8，避免后续 prepare/register 又打到旧记录 3。
    # 参数：
    #   无。
    # 返回值：
    #   解析正确返回 0；解析到旧嵌套 id 或缺失 id 时返回非 0。
    tmp_file="${TMPDIR:-/tmp}/defect-cos-json-parser-self-test.$$"
    trap 'rm -f "$tmp_file"' EXIT HUP INT TERM

    cat > "$tmp_file" <<'JSON'
{"id":8,"record_no":"MP157-20260507-221151","part":{"id":3,"part_no":"SIM-DIANPIAN"},"device":{"id":3,"device_no":"MP157"}}
JSON

    parsed_id=$(extract_created_record_id "$tmp_file")
    if [ "$parsed_id" != "8" ]; then
        fail "JSON 解析自检失败：期望顶层 record_id=8，实际解析到 $parsed_id"
    fi

    parsed_no=$(extract_created_record_no "$tmp_file")
    if [ "$parsed_no" != "MP157-20260507-221151" ]; then
        fail "JSON 解析自检失败：期望 record_no=MP157-20260507-221151，实际解析到 $parsed_no"
    fi
}

run_time_format_self_test()
{
    # run_time_format_self_test 的作用：
    #   验证业务时间不会把板端当前墙钟二次换算成未来 8 小时。
    # 主要流程：
    #   1. 注入固定 date 命令，让墙钟时间固定为 2026-05-08T13:07:02。
    #   2. 设置 CLOUD_TIME_OFFSET=+08:00，模拟中国本地业务时间。
    #   3. 断言输出必须保持 13:07:02+08:00，不能变成 21:07:02+08:00。
    # 参数：
    #   无。
    # 返回值：
    #   时间格式正确返回 0；出现二次时区换算返回非 0。
    old_cmd="${CLOUD_TIME_NOW_CMD:-}"
    old_offset="${CLOUD_TIME_OFFSET:-}"

    CLOUD_TIME_NOW_CMD="printf 2026-05-08T13:07:02"
    CLOUD_TIME_OFFSET="+08:00"
    parsed_time="$(iso8601_local_now)"

    CLOUD_TIME_NOW_CMD="$old_cmd"
    CLOUD_TIME_OFFSET="$old_offset"

    if [ "$parsed_time" != "2026-05-08T13:07:02+08:00" ]; then
        fail "时间格式自检失败：期望 2026-05-08T13:07:02+08:00，实际 $parsed_time"
    fi
}

run_part_code_self_test()
{
    # run_part_code_self_test 的作用：
    #   验证“零件类型”和“好坏结果”分离的上传契约。
    # 主要流程：
    #   1. 构造云端零件列表，列表里只有 gasket、washer、splitwasher 三种零件类型。
    #   2. 分别用 gasket_good 和 gasket_bad 匹配，二者必须得到同一个 gasket part_id。
    #   3. 再用 washer_good 匹配，必须得到 washer 的另一个 part_id，证明不同零件才切换类型。
    # 参数：
    #   无。
    # 返回值：
    #   映射正确返回 0；好坏后缀导致零件类型分裂时返回非 0。
    tmp_file="${TMPDIR:-/tmp}/defect-cos-parts-self-test.$$"
    old_part_code="${CLOUD_PART_CODE:-}"
    old_class_label="${CLOUD_CLASS_LABEL:-}"
    trap 'rm -f "$tmp_file"' EXIT HUP INT TERM

    cat > "$tmp_file" <<'JSON'
{"items":[{"id":11,"part_code":"gasket","name":"垫片","category":"washer-family"},{"id":12,"part_code":"washer","name":"平垫圈","category":"washer-family"},{"id":13,"part_code":"splitwasher","name":"弹垫","category":"washer-family"}],"total":3,"skip":0,"limit":100}
JSON

    CLOUD_PART_CODE=""
    CLOUD_CLASS_LABEL="gasket_good"
    if [ "$(class_label_to_part_code)" != "gasket" ]; then
        CLOUD_PART_CODE="$old_part_code"
        CLOUD_CLASS_LABEL="$old_class_label"
        fail "零件类型自检失败：gasket_good 未归一成 gasket"
    fi
    good_part_id="$(extract_part_id_by_code "$tmp_file" "$(class_label_to_part_code)")"

    CLOUD_CLASS_LABEL="gasket_bad"
    if [ "$(class_label_to_part_code)" != "gasket" ]; then
        CLOUD_PART_CODE="$old_part_code"
        CLOUD_CLASS_LABEL="$old_class_label"
        fail "零件类型自检失败：gasket_bad 未归一成 gasket"
    fi
    bad_part_id="$(extract_part_id_by_code "$tmp_file" "$(class_label_to_part_code)")"

    CLOUD_CLASS_LABEL="washer_good"
    washer_part_id="$(extract_part_id_by_code "$tmp_file" "$(class_label_to_part_code)")"

    CLOUD_PART_CODE="$old_part_code"
    CLOUD_CLASS_LABEL="$old_class_label"

    if [ "$good_part_id" != "11" ] || [ "$bad_part_id" != "11" ]; then
        fail "零件类型自检失败：gasket_good/gasket_bad 必须映射到同一个 part_id=11，实际 good=$good_part_id bad=$bad_part_id"
    fi

    if [ "$washer_part_id" != "12" ]; then
        fail "零件类型自检失败：不同零件 washer 应映射到 part_id=12，实际 $washer_part_id"
    fi
}

cloud_part_name_from_code()
{
    # cloud_part_name_from_code 的作用：
    #   把板端模型输出的零件编码转换成云端自动创建零件时使用的中文名称。
    # 主要流程：
    #   1. 优先保留部署现场显式设置的 CLOUD_PART_NAME。
    #   2. 对已知模型类别做中文名称映射，避免云端出现错误翻译或生硬编码。
    #   3. 未知类别回退为原始 part_code，让云端仍能创建并保留可追踪编码。
    # 参数：
    #   $1：归一化后的零件编码，例如 wave_washer。
    # 返回值：
    #   stdout 输出云端 Part.name。
    part_code="$1"

    if [ -n "${CLOUD_PART_NAME:-}" ]; then
        printf '%s\n' "$CLOUD_PART_NAME"
        return 0
    fi

    case "$part_code" in
        wave_washer)
            printf '%s\n' "波形垫圈"
            ;;
        gasket)
            printf '%s\n' "波形垫圈"
            ;;
        washer)
            printf '%s\n' "平垫圈"
            ;;
        splitwasher)
            printf '%s\n' "弹性垫圈"
            ;;
        *)
            printf '%s\n' "$part_code"
            ;;
    esac
}

cloud_part_category_from_code()
{
    # cloud_part_category_from_code 的作用：
    #   为云端自动创建零件补充分类字段，方便零件列表和统计页按类别聚合。
    # 主要流程：
    #   1. 优先使用部署现场显式设置的 CLOUD_PART_CATEGORY。
    #   2. 对已知垫圈类零件写入稳定中文分类。
    #   3. 未知类别返回空字符串，让云端创建未分类零件。
    # 参数：
    #   $1：归一化后的零件编码。
    # 返回值：
    #   stdout 输出云端 Part.category；未知时输出空字符串。
    part_code="$1"

    if [ -n "${CLOUD_PART_CATEGORY:-}" ]; then
        printf '%s\n' "$CLOUD_PART_CATEGORY"
        return 0
    fi

    case "$part_code" in
        wave_washer)
            printf '%s\n' "垫圈类"
            ;;
        gasket|washer|splitwasher)
            printf '%s\n' "垫圈类"
            ;;
        *)
            return 0
            ;;
    esac
}

record_part_payload_fields()
{
    # record_part_payload_fields 的作用：
    #   根据当前脚本解析到的零件身份生成 POST /api/v1/records 所需的 JSON 字段片段。
    # 主要流程：
    #   1. 如果已有 CLOUD_PART_ID，保持旧协议字段 `"part_id":<id>`，兼容手工指定和云端已存在零件。
    #   2. 如果没有 part_id 但有 part_code，改走云端自动创建路径，发送 part_code、part_name、part_category 和 auto_create_part。
    #   3. 如果两者都缺失，立即失败，避免创建没有零件归属的检测记录。
    # 参数：
    #   无显式参数；读取 CLOUD_PART_ID、CLOUD_PART_CODE、CLOUD_PART_NAME、CLOUD_PART_CATEGORY。
    # 返回值：
    #   stdout 输出带前导两个空格的 JSON 字段片段，调用方直接拼入 record_body。
    request_part_code="$(class_label_to_part_code)"

    if is_positive_number "${CLOUD_PART_ID:-}"; then
        printf '  "part_id":%s' "$CLOUD_PART_ID"
        return 0
    fi

    if [ -z "$request_part_code" ]; then
        fail "缺少零件类型：请设置 CLOUD_PART_CODE/CLOUD_CLASS_LABEL 或 CLOUD_PART_ID"
    fi

    request_part_name="$(cloud_part_name_from_code "$request_part_code")"
    request_part_category="$(cloud_part_category_from_code "$request_part_code")"
    request_part_code_json="$(json_escape "$request_part_code")"
    request_part_name_json="$(json_escape "$request_part_name")"
    request_part_category_json="$(json_escape "$request_part_category")"

    if [ -n "$request_part_category" ]; then
        printf '  "part_code":"%s",\n  "part_name":"%s",\n  "part_category":"%s",\n  "auto_create_part":true' \
            "$request_part_code_json" \
            "$request_part_name_json" \
            "$request_part_category_json"
    else
        printf '  "part_code":"%s",\n  "part_name":"%s",\n  "auto_create_part":true' \
            "$request_part_code_json" \
            "$request_part_name_json"
    fi
}

run_auto_create_part_self_test()
{
    # run_auto_create_part_self_test 的作用：
    #   验证未知零件类型不再让板端脚本提前失败，而是能生成云端自动创建零件请求字段。
    # 主要流程：
    #   1. 模拟云端未返回 part_id 的状态。
    #   2. 设置 CLOUD_PART_CODE=wave_washer，检查请求字段包含自动创建开关和正确中文名称。
    #   3. 恢复进入自检前的全局变量，避免影响其它自检。
    # 参数：
    #   无。
    # 返回值：
    #   自动创建字段正确返回 0；字段缺失或中文名称错误时终止脚本。
    old_part_id="${CLOUD_PART_ID:-}"
    old_part_code="${CLOUD_PART_CODE:-}"
    old_part_name="${CLOUD_PART_NAME:-}"
    old_part_category="${CLOUD_PART_CATEGORY:-}"
    old_class_label="${CLOUD_CLASS_LABEL:-}"

    CLOUD_PART_ID=""
    CLOUD_PART_CODE="wave_washer"
    CLOUD_PART_NAME=""
    CLOUD_PART_CATEGORY=""
    CLOUD_CLASS_LABEL="wave_washer_good"

    payload_fields="$(record_part_payload_fields)"

    CLOUD_PART_ID="$old_part_id"
    CLOUD_PART_CODE="$old_part_code"
    CLOUD_PART_NAME="$old_part_name"
    CLOUD_PART_CATEGORY="$old_part_category"
    CLOUD_CLASS_LABEL="$old_class_label"

    printf '%s\n' "$payload_fields" | grep -q '"part_code":"wave_washer"' \
        || fail "自动创建零件自检失败：请求体缺少 part_code=wave_washer"
    printf '%s\n' "$payload_fields" | grep -q '"part_name":"波形垫圈"' \
        || fail "自动创建零件自检失败：wave_washer 必须写入中文名称“波形垫圈”"
    printf '%s\n' "$payload_fields" | grep -q '"part_category":"垫圈类"' \
        || fail "自动创建零件自检失败：wave_washer 必须写入分类“垫圈类”"
    printf '%s\n' "$payload_fields" | grep -q '"auto_create_part":true' \
        || fail "自动创建零件自检失败：请求体缺少 auto_create_part=true"
}

add_annotated_file()
{
    # add_annotated_file 的作用：
    #   把一张检测结果图加入待上传列表。
    # 主要流程：
    #   1. 检查参数不能为空，避免生成空行导致后续 validate_file 报错不直观。
    #   2. 使用换行追加路径，保留调用方传入的顺序。
    # 参数：
    #   $1：检测结果图路径，可以是 jpg/jpeg/png。
    # 返回值：
    #   成功时只更新 ANNOTATED_FILES；参数为空时终止脚本。
    path="$1"

    if [ -z "$path" ]; then
        fail "--annotated 路径为空"
    fi

    if [ -z "$ANNOTATED_FILES" ]; then
        ANNOTATED_FILES="$path"
    else
        ANNOTATED_FILES="${ANNOTATED_FILES}
$path"
    fi
}

detect_content_type()
{
    # detect_content_type 的作用：
    #   根据本地图片扩展名推断 COS Content-Type。
    # 主要流程：
    #   1. 只接受 jpg/jpeg/png 三类浏览器可预览图片。
    #   2. jpg/jpeg 返回 image/jpeg，png 返回 image/png。
    # 参数：
    #   $1：本地图片路径。
    # 返回值：
    #   stdout 输出 MIME 类型；扩展名不支持时终止脚本。
    path="$1"

    case "$path" in
        *.[Jj][Pp][Gg]|*.[Jj][Pp][Ee][Gg])
            printf '%s\n' "image/jpeg"
            ;;
        *.[Pp][Nn][Gg])
            printf '%s\n' "image/png"
            ;;
        *)
            fail "不支持的图片格式：$path，只允许 jpg/jpeg/png"
            ;;
    esac
}

annotated_header_path()
{
    # annotated_header_path 的作用：
    #   为第 N 张 annotated 图片生成独立 COS 响应头保存路径。
    # 主要流程：
    #   1. 如果 ANNOTATED_HEADERS 带扩展名，就把序号插入到扩展名前。
    #   2. 如果没有扩展名，就直接追加 -N，避免生成包含斜杠的异常路径。
    # 参数：
    #   $1：annotated 图片序号，从 1 开始。
    # 返回值：
    #   stdout 输出响应头文件路径。
    index="$1"
    header_dir="$(dirname "$ANNOTATED_HEADERS")"
    header_name="$(basename "$ANNOTATED_HEADERS")"

    case "$header_name" in
        *.*)
            printf '%s/%s-%s.%s\n' "$header_dir" "${header_name%.*}" "$index" "${header_name##*.}"
            ;;
        *)
            printf '%s/%s-%s\n' "$header_dir" "$header_name" "$index"
            ;;
    esac
}

run_arg_parser_self_test()
{
    # run_arg_parser_self_test 的作用：
    #   在不访问网络的情况下验证新上传参数契约。
    # 主要流程：
    #   1. 校验 JPG/JPEG/PNG 能推断正确 Content-Type。
    #   2. 校验 add_annotated_file 能保留两张 annotated 结果图。
    # 参数：
    #   无。
    # 返回值：
    #   解析契约正确返回 0；任何断言失败返回非 0。
    old_annotated_files="$ANNOTATED_FILES"

    ANNOTATED_FILES=""
    add_annotated_file "/tmp/unet_overlay.jpg"
    add_annotated_file "/tmp/unet_mask.png"

    annotated_count=$(printf '%s\n' "$ANNOTATED_FILES" | sed '/^$/d' | wc -l | tr -d ' ')
    if [ "$annotated_count" != "2" ]; then
        ANNOTATED_FILES="$old_annotated_files"
        fail "参数解析自检失败：期望 2 张 annotated，实际 $annotated_count"
    fi

    if [ "$(detect_content_type "/tmp/unet_overlay.jpg")" != "image/jpeg" ]; then
        ANNOTATED_FILES="$old_annotated_files"
        fail "参数解析自检失败：jpg 未识别为 image/jpeg"
    fi

    if [ "$(detect_content_type "/tmp/unet_overlay.JPEG")" != "image/jpeg" ]; then
        ANNOTATED_FILES="$old_annotated_files"
        fail "参数解析自检失败：jpeg 未识别为 image/jpeg"
    fi

    if [ "$(detect_content_type "/tmp/unet_mask.png")" != "image/png" ]; then
        ANNOTATED_FILES="$old_annotated_files"
        fail "参数解析自检失败：png 未识别为 image/png"
    fi

    ANNOTATED_HEADERS="/tmp/annotated_upload_headers.txt"
    if [ "$(annotated_header_path 2)" != "/tmp/annotated_upload_headers-2.txt" ]; then
        ANNOTATED_FILES="$old_annotated_files"
        fail "参数解析自检失败：带扩展名 header 路径生成错误"
    fi

    ANNOTATED_HEADERS="/tmp/annotated_upload_headers"
    if [ "$(annotated_header_path 2)" != "/tmp/annotated_upload_headers-2" ]; then
        ANNOTATED_FILES="$old_annotated_files"
        fail "参数解析自检失败：无扩展名 header 路径生成错误"
    fi

    ANNOTATED_HEADERS="/tmp/dir.with.dot/annotated_upload_headers"
    if [ "$(annotated_header_path 2)" != "/tmp/dir.with.dot/annotated_upload_headers-2" ]; then
        ANNOTATED_FILES="$old_annotated_files"
        fail "参数解析自检失败：目录带点时 header 路径生成错误"
    fi

    ANNOTATED_FILES="$old_annotated_files"
}

http_json()
{
    # 统一发送 JSON 请求；调用者通过返回文件读取响应体，HTTP 非 2xx 时 curl 会返回失败。
    method="$1"
    url="$2"
    body="$3"
    out_file="$4"

    curl -fsS \
        -b "$CLOUD_COOKIE_FILE" \
        -c "$CLOUD_COOKIE_FILE" \
        -H "Content-Type: application/json" \
        -X "$method" \
        "$url" \
        -d "$body" \
        -o "$out_file"
}

http_get()
{
    # 统一发送带 Cookie 的 GET 请求，用于自动发现当前账号可访问的零件和设备。
    url="$1"
    out_file="$2"

    curl -fsS \
        -b "$CLOUD_COOKIE_FILE" \
        -c "$CLOUD_COOKIE_FILE" \
        "$url" \
        -o "$out_file"
}

load_upload_env_file

apply_runtime_overrides()
{
    # apply_runtime_overrides 的作用：
    #   让命令行环境变量优先级高于 cos-upload.env，便于临时切换账号或指定云端对象。
    # 主要流程：
    #   逐个检查脚本启动时记录的非空覆盖值；如果存在，就覆盖配置文件读取到的默认值。
    # 参数：
    #   无显式参数；读取上面的 *_OVERRIDE 变量。
    # 返回值：
    #   只修改当前 shell 变量，不输出内容。
    [ -z "$CLOUD_BASE_URL_OVERRIDE" ] || CLOUD_BASE_URL="$CLOUD_BASE_URL_OVERRIDE"
    [ -z "$CLOUD_COOKIE_FILE_OVERRIDE" ] || CLOUD_COOKIE_FILE="$CLOUD_COOKIE_FILE_OVERRIDE"
    [ -z "$CLOUD_ACCOUNT_OVERRIDE" ] || CLOUD_ACCOUNT="$CLOUD_ACCOUNT_OVERRIDE"
    [ -z "$CLOUD_PASSWORD_OVERRIDE" ] || CLOUD_PASSWORD="$CLOUD_PASSWORD_OVERRIDE"
    [ -z "$CLOUD_DEVICE_ID_OVERRIDE" ] || CLOUD_DEVICE_ID="$CLOUD_DEVICE_ID_OVERRIDE"
    [ -z "$CLOUD_PART_ID_OVERRIDE" ] || CLOUD_PART_ID="$CLOUD_PART_ID_OVERRIDE"
    [ -z "$CLOUD_PART_CODE_OVERRIDE" ] || CLOUD_PART_CODE="$CLOUD_PART_CODE_OVERRIDE"
    [ -z "$CLOUD_PART_NAME_OVERRIDE" ] || CLOUD_PART_NAME="$CLOUD_PART_NAME_OVERRIDE"
    [ -z "$CLOUD_PART_CATEGORY_OVERRIDE" ] || CLOUD_PART_CATEGORY="$CLOUD_PART_CATEGORY_OVERRIDE"
    [ -z "$CLOUD_CLASS_LABEL_OVERRIDE" ] || CLOUD_CLASS_LABEL="$CLOUD_CLASS_LABEL_OVERRIDE"
    [ -z "$CLOUD_RESULT_OVERRIDE" ] || CLOUD_RESULT="$CLOUD_RESULT_OVERRIDE"
    [ -z "$CLOUD_HEALTH_URL_OVERRIDE" ] || CLOUD_HEALTH_URL="$CLOUD_HEALTH_URL_OVERRIDE"
    [ -z "$CLOUD_TIME_TZ_OVERRIDE" ] || CLOUD_TIME_TZ="$CLOUD_TIME_TZ_OVERRIDE"
    [ -z "$CLOUD_TIME_OFFSET_OVERRIDE" ] || CLOUD_TIME_OFFSET="$CLOUD_TIME_OFFSET_OVERRIDE"
    [ -z "$CLOUD_TIME_NOW_CMD_OVERRIDE" ] || CLOUD_TIME_NOW_CMD="$CLOUD_TIME_NOW_CMD_OVERRIDE"
    [ -z "$SOURCE_HEADERS_OVERRIDE" ] || SOURCE_HEADERS="$SOURCE_HEADERS_OVERRIDE"
    [ -z "$ANNOTATED_HEADERS_OVERRIDE" ] || ANNOTATED_HEADERS="$ANNOTATED_HEADERS_OVERRIDE"
}

apply_runtime_overrides

# CLOUD_BASE_URL 是云端后端地址，默认使用迁移后的新服务器地址。
# 账号、接口路径和 Cookie 逻辑不变；现场排查时仍可通过环境变量覆盖。
CLOUD_BASE_URL="${CLOUD_BASE_URL:-http://139.9.35.72}"

# CLOUD_COOKIE_FILE 保存后端登录态 Cookie，避免每次点击按钮都重复登录。
CLOUD_COOKIE_FILE="${CLOUD_COOKIE_FILE:-/tmp/cloud_cookie.txt}"

# CLOUD_ACCOUNT/CLOUD_PASSWORD 只在 Cookie 不存在时使用；可以来自环境变量或本地 cos-upload.env。
CLOUD_ACCOUNT="${CLOUD_ACCOUNT:-}"
CLOUD_PASSWORD="${CLOUD_PASSWORD:-}"

# CLOUD_DEVICE_ID/CLOUD_PART_ID 可显式指定云端已有的 MP157 设备和零件 ID。
# CLOUD_PART_ID 优先级最高；CLOUD_PART_CODE/CLOUD_CLASS_LABEL 用来按零件类型查询云端 part_id。
# 如果云端没有匹配零件，脚本会保留 part_code 并在创建检测记录时请求云端自动创建零件。
CLOUD_DEVICE_ID="${CLOUD_DEVICE_ID:-}"
CLOUD_PART_ID="${CLOUD_PART_ID:-}"

# CLOUD_PART_CODE 是板端明确传入的零件类型，例如 gasket、washer、splitwasher。
# CLOUD_CLASS_LABEL 是分类模型原始类别，例如 gasket_good；脚本会去掉 good/bad 后缀再匹配零件。
# CLOUD_PART_NAME/CLOUD_PART_CATEGORY 是自动创建零件时的可选中文名称和分类覆盖值。
CLOUD_PART_CODE="${CLOUD_PART_CODE:-}"
CLOUD_PART_NAME="${CLOUD_PART_NAME:-}"
CLOUD_PART_CATEGORY="${CLOUD_PART_CATEGORY:-}"
CLOUD_CLASS_LABEL="${CLOUD_CLASS_LABEL:-}"

# CLOUD_RESULT 是本次模型检测结果，Qt 检测链路会显式传入 good、bad 或 review。
# 默认 review 是保守值，避免没有模型结果时把云端记录静默写成良品。
CLOUD_RESULT="${CLOUD_RESULT:-review}"

# CLOUD_HEALTH_URL 默认访问后端 /health，验证 HTTP 服务是否在线。
CLOUD_HEALTH_URL="${CLOUD_HEALTH_URL:-$CLOUD_BASE_URL/health}"

# CLOUD_TIME_TZ 是旧版本保留变量，不再参与时间换算；避免板端墙钟已经是北京时间时又被加 8 小时。
CLOUD_TIME_TZ="${CLOUD_TIME_TZ:-CST-8}"

# CLOUD_TIME_OFFSET 是写入后端业务时间时携带的时区偏移；默认 +08:00 表示中国本地业务时间。
CLOUD_TIME_OFFSET="${CLOUD_TIME_OFFSET:-+08:00}"
CLOUD_TIME_ZONE="${CLOUD_TIME_ZONE:-CST-8}"

# 导出北京时间时区，保证检测图片上传时读取的是业务本地墙钟。
# 板端校时后系统 UTC 是正确的，但 BusyBox/登录环境不一定自动读取 /etc/TZ；
# 如果这里不显式导出，date 可能输出 UTC 小时，最终 captured_at/uploaded_at 会少 8 小时。
export TZ="$CLOUD_TIME_ZONE"

# CLOUD_TIME_NOW_CMD 只供自检注入固定时间命令，正式运行保持为空。
CLOUD_TIME_NOW_CMD="${CLOUD_TIME_NOW_CMD:-}"

# 上传响应头保存位置，便于开发板 SSH 排查 COS 返回的 ETag 和 HTTP 状态。
SOURCE_HEADERS="${SOURCE_HEADERS:-/tmp/source_upload_headers.txt}"
ANNOTATED_HEADERS="${ANNOTATED_HEADERS:-/tmp/annotated_upload_headers.txt}"

ensure_cloud_session()
{
    # Cookie 文件存在且非空时直接复用；否则使用 CLOUD_ACCOUNT/CLOUD_PASSWORD 登录。
    if [ -s "$CLOUD_COOKIE_FILE" ]; then
        return 0
    fi

    if [ -z "$CLOUD_ACCOUNT" ] || [ -z "$CLOUD_PASSWORD" ]; then
        fail "缺少登录 Cookie，且未设置 CLOUD_ACCOUNT/CLOUD_PASSWORD"
    fi

    account_json=$(json_escape "$CLOUD_ACCOUNT")
    password_json=$(json_escape "$CLOUD_PASSWORD")
    login_body="{\"account\":\"$account_json\",\"password\":\"$password_json\"}"

    http_json "POST" "$CLOUD_BASE_URL/api/v1/auth/login" "$login_body" "/tmp/defect-cos-login.json" \
        || fail "登录后端失败，请检查 CLOUD_ACCOUNT/CLOUD_PASSWORD"
}

resolve_cloud_ids()
{
    # 如果部署现场没有指定 ID，就按板端零件类型查询云端零件列表，再读取当前账号能访问的设备。
    # 查不到零件时不再失败，而是让 create_record() 走云端自动创建路径。
    if [ -z "$CLOUD_PART_ID" ]; then
        requested_part_code="$(class_label_to_part_code)"

        http_get "$CLOUD_BASE_URL/api/v1/parts?limit=100" "/tmp/defect-cos-parts.json" \
            || fail "自动查询零件列表失败，请手动设置 CLOUD_PART_ID"

        if [ -n "$requested_part_code" ]; then
            CLOUD_PART_ID=$(extract_part_id_by_code "/tmp/defect-cos-parts.json" "$requested_part_code")
            if [ -z "$CLOUD_PART_ID" ]; then
                CLOUD_PART_CODE="$requested_part_code"
                log_upload_step "resolved_part_code=$CLOUD_PART_CODE"
                log_upload_step "resolved_part_id=未匹配到云端零件，将由云端自动创建"
            else
                CLOUD_PART_CODE="$requested_part_code"
                log_upload_step "resolved_part_code=$CLOUD_PART_CODE"
                log_upload_step "resolved_part_id=$CLOUD_PART_ID"
            fi
        else
            CLOUD_PART_ID=$(extract_json_number "id" "/tmp/defect-cos-parts.json")
            if [ -n "$CLOUD_PART_ID" ]; then
                log_upload_step "resolved_part_code=未传零件类型，使用第一条零件兜底"
            fi
            if [ -z "$CLOUD_PART_ID" ]; then
                fail "当前账号没有可用零件，且板端没有传入 CLOUD_PART_CODE/CLOUD_CLASS_LABEL，无法自动创建零件"
            fi
        fi
    fi

    if [ -n "$CLOUD_PART_ID" ]; then
        log_upload_step "resolved_part_id=$CLOUD_PART_ID"
    fi

    if [ -z "$CLOUD_DEVICE_ID" ]; then
        http_get "$CLOUD_BASE_URL/api/v1/devices?limit=1" "/tmp/defect-cos-devices.json" \
            || fail "自动查询设备列表失败，请手动设置 CLOUD_DEVICE_ID"

        CLOUD_DEVICE_ID=$(extract_json_number "id" "/tmp/defect-cos-devices.json")
        if [ -z "$CLOUD_DEVICE_ID" ]; then
            fail "当前账号没有可用设备，请先在云端创建设备或设置 CLOUD_DEVICE_ID"
        fi
    fi
}

validate_file()
{
    # 检测流程返回成功后仍在上传前做一次文件非空检查，避免网络流程上传空文件。
    path="$1"
    label="$2"

    if [ ! -f "$path" ]; then
        fail "$label 文件不存在：$path"
    fi

    if [ ! -s "$path" ]; then
        fail "$label 文件为空：$path"
    fi
}

validate_cloud_result()
{
    # validate_cloud_result 的作用：
    #   校验即将写入云端检测记录的 result 字段，防止调用方遗漏模型结果时误写固定良品。
    # 主要流程：
    #   1. 只接受后端约定的 good、bad、review 三种短值。
    #   2. 其它值直接终止脚本，让 Qt/SSH 日志暴露配置错误。
    # 参数：
    #   $1：准备写入云端 records.result 的检测结果。
    # 返回值：
    #   合法返回 0；非法时调用 fail 退出。
    case "$1" in
        good|bad|review)
            return 0
            ;;
        *)
            fail "非法 CLOUD_RESULT：$1，只允许 good、bad、review"
            ;;
    esac
}

create_record()
{
    # create_record 的作用：
    #   创建云端检测主记录，并只返回本次新建记录的顶层 record_id。
    # 主要流程：
    #   1. 用本地时间生成 record_no，方便云端详情页和板端日志人工对账。
    #   2. captured_at/detected_at 使用带时区的本地时间，避免 UTC 无时区显示成 8 小时前。
    #   3. POST /api/v1/records 后，只解析响应顶层 id，不能读取嵌套 part.id/device.id。
    #   4. 校验云端返回的 record_no 与本次请求一致，防止后端复用旧演示记录。
    # 参数：
    #   无显式参数；读取 CLOUD_PART_ID/CLOUD_PART_CODE/CLOUD_DEVICE_ID/CLOUD_RESULT。
    # 返回值：
    #   stdout 输出正整数 record_id；失败时终止脚本。
    record_no="MP157-$(date '+%Y%m%d-%H%M%S')"
    captured_at="$(iso8601_local_now)"
    request_part_code="$(class_label_to_part_code)"
    request_part_code_json="$(json_escape "$request_part_code")"
    request_class_label_json="$(json_escape "${CLOUD_CLASS_LABEL:-}")"
    record_part_fields="$(record_part_payload_fields)"
    record_body="{
\"record_no\":\"$record_no\",
$record_part_fields,
\"device_id\":$CLOUD_DEVICE_ID,
\"result\":\"$CLOUD_RESULT\",
\"device_context\":{\"part_code\":\"$request_part_code_json\",\"class_label\":\"$request_class_label_json\"},
\"captured_at\":\"$captured_at\",
\"detected_at\":\"$captured_at\"
}"

    http_json "POST" "$CLOUD_BASE_URL/api/v1/records" "$record_body" "/tmp/defect-cos-record.json" \
        || fail "创建检测记录失败"

    record_id=$(extract_created_record_id "/tmp/defect-cos-record.json")
    if ! is_positive_number "$record_id"; then
        fail "创建检测记录响应缺少 id"
    fi

    created_record_no=$(extract_created_record_no "/tmp/defect-cos-record.json")
    if [ -z "$created_record_no" ]; then
        fail "创建检测记录响应缺少 record_no"
    fi

    if [ "$created_record_no" != "$record_no" ]; then
        fail "云端返回 record_no 与本次请求不一致：request=$record_no response=$created_record_no"
    fi

    log_upload_step "record_no=$created_record_no"
    log_upload_step "created_record_id=$record_id"

    printf '%s\n' "$record_id"
}

prepare_upload()
{
    # prepare_upload 的作用：
    #   为本次记录的一张图片申请 COS 预签名上传地址，并防止 prepare 落到旧记录路径。
    # 主要流程：
    #   1. 校验 record_id 是创建记录返回的正整数。
    #   2. POST /api/v1/uploads/cos/prepare，body 中携带同一个 record_id。
    #   3. 检查 prepare 返回启用状态、object_key，并断言 object_key 包含当前 record_no。
    # 参数：
    #   $1 record_id：创建记录返回的新记录 id。
    #   $2 record_no：创建记录返回的新记录编号。
    #   $3 file_kind：云端文件类型，source 或 annotated。
    #   $4 local_tag：本地临时文件标签，用于区分多张 annotated 图片。
    #   $5 file_path：本地 JPG/PNG 路径。
    #   $6 content_type：image/jpeg 或 image/png。
    # 返回值：
    #   成功时生成 /tmp/defect-cos-prepare-<local_tag>.json；失败时终止脚本。
    record_id="$1"
    record_no="$2"
    file_kind="$3"
    local_tag="$4"
    file_path="$5"
    content_type="$6"
    prepare_file="/tmp/defect-cos-prepare-$local_tag.json"
    file_name="$(basename "$file_path")"
    file_name_json=$(json_escape "$file_name")

    if ! is_positive_number "$record_id"; then
        fail "prepare 收到非法 record_id：$record_id"
    fi

    prepare_body="{
\"record_id\":$record_id,
\"file_kind\":\"$file_kind\",
\"file_name\":\"$file_name_json\",
\"content_type\":\"$content_type\"
}"

    http_json "POST" "$CLOUD_BASE_URL/api/v1/uploads/cos/prepare" "$prepare_body" "$prepare_file" \
        || fail "COS prepare 失败：$local_tag"

    enabled=$(sed -n 's/.*"enabled"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' "$prepare_file" | head -n 1)
    if [ "$enabled" != "true" ]; then
        message=$(extract_json_string "message" "$prepare_file")
        fail "COS prepare 未启用：$local_tag ${message:-unknown}"
    fi

    object_key=$(extract_json_string "object_key" "$prepare_file")
    if [ -z "$object_key" ]; then
        fail "prepare 响应缺少 object_key：$local_tag"
    fi

    case "$object_key" in
        *"$record_no"*)
            ;;
        *)
            fail "prepare object_key 未包含当前 record_no：file_kind=$file_kind record_no=$record_no object_key=$object_key"
            ;;
    esac

    log_upload_step "prepare_file_kind=$file_kind prepare_record_id=$record_id"
    log_upload_step "prepare_local_tag=$local_tag"
    log_upload_step "prepare_object_key=$object_key"
}

put_to_cos()
{
    # COS 预签名 URL 要求 PUT 时 Content-Type 和 prepare 请求保持一致。
    local_tag="$1"
    file_path="$2"
    content_type="$3"
    header_file="$4"
    prepare_file="/tmp/defect-cos-prepare-$local_tag.json"
    upload_url=$(extract_json_string "upload_url" "$prepare_file")

    if [ -z "$upload_url" ]; then
        fail "prepare 响应缺少 upload_url：$local_tag"
    fi

    http_code=$(curl -sS \
        -X PUT "$upload_url" \
        -H "Content-Type: $content_type" \
        -D "$header_file" \
        -o /tmp/defect-cos-put-body.txt \
        -w "%{http_code}" \
        -T "$file_path")

    if [ "$http_code" != "200" ]; then
        fail "COS PUT 失败：$local_tag HTTP_CODE=$http_code"
    fi

    etag=$(extract_etag_header "$header_file")
    if [ -z "$etag" ]; then
        fail "COS PUT 成功但响应头缺少 ETag：$local_tag"
    fi
}

register_file()
{
    # register_file 的作用：
    #   把 COS 对象元数据登记回创建记录返回的新 record_id，云端详情页才能生成 preview_url。
    # 主要流程：
    #   1. 读取 prepare 返回的 bucket、region、object_key。
    #   2. 读取 COS PUT 响应头里的 ETag 和本地文件字节数。
    #   3. POST /api/v1/records/{record_id}/files，URL 中必须继续使用本次新 record_id。
    #   4. uploaded_at 使用带本地时区的时间，短期规避后端 UTC fallback 显示偏移。
    # 参数：
    #   $1 record_id：创建记录返回的新记录 id。
    #   $2 file_kind：云端文件类型，source 或 annotated。
    #   $3 local_tag：本地临时文件标签，用于读取对应 prepare 响应。
    #   $4 file_path：本地 JPG/PNG 路径。
    #   $5 content_type：image/jpeg 或 image/png。
    #   $6 header_file：COS PUT 响应头文件。
    # 返回值：
    #   成功时生成 /tmp/defect-cos-register-<local_tag>.json；失败时终止脚本。
    record_id="$1"
    file_kind="$2"
    local_tag="$3"
    file_path="$4"
    content_type="$5"
    header_file="$6"
    prepare_file="/tmp/defect-cos-prepare-$local_tag.json"

    if ! is_positive_number "$record_id"; then
        fail "登记文件收到非法 record_id：$record_id"
    fi

    bucket_name=$(extract_json_string "bucket_name" "$prepare_file")
    region=$(extract_json_string "region" "$prepare_file")
    object_key=$(extract_json_string "object_key" "$prepare_file")
    etag=$(extract_etag_header "$header_file")
    size_bytes=$(wc -c < "$file_path" | tr -d ' ')
    uploaded_at="$(iso8601_local_now)"
    bucket_json=$(json_escape "$bucket_name")
    region_json=$(json_escape "$region")
    object_key_json=$(json_escape "$object_key")
    etag_json=$(json_escape "$etag")
    uploaded_at_json=$(json_escape "$uploaded_at")

    if [ -z "$bucket_name" ] || [ -z "$region" ] || [ -z "$object_key" ]; then
        fail "prepare 响应缺少对象元数据：$local_tag"
    fi

    register_body="{
\"file_kind\":\"$file_kind\",
\"storage_provider\":\"cos\",
\"bucket_name\":\"$bucket_json\",
\"region\":\"$region_json\",
\"object_key\":\"$object_key_json\",
\"content_type\":\"$content_type\",
\"size_bytes\":$size_bytes,
\"etag\":\"$etag_json\",
\"uploaded_at\":\"$uploaded_at_json\"
}"

    log_upload_step "register_url=/api/v1/records/$record_id/files"
    log_upload_step "register_file_kind=$file_kind"
    log_upload_step "register_local_tag=$local_tag"

    http_json "POST" "$CLOUD_BASE_URL/api/v1/records/$record_id/files" "$register_body" "/tmp/defect-cos-register-$local_tag.json" \
        || fail "登记文件对象失败：$local_tag"
}

verify_record_detail()
{
    # verify_record_detail 的作用：
    #   上传完成后回查本次新记录，确认详情里能看到 source 和所有 annotated 结果图。
    # 主要流程：
    #   1. GET /api/v1/records/{record_id} 保存到 /tmp/defect-cos-record-detail.json。
    #   2. 检查详情响应包含 source 与 annotated，避免只登记了一类图还误报成功。
    #   3. 粗略统计 file_kind 数量；若不是期望数量，直接失败。
    # 参数：
    #   $1 record_id：创建记录返回的新记录 id。
    #   $2 expected_file_count：期望文件总数，等于 1 张 source + N 张 annotated。
    # 返回值：
    #   两类文件都存在返回 0；缺失或回查失败时返回非 0，让调用者决定是否降级。
    record_id="$1"
    expected_file_count="$2"

    if ! is_positive_number "$record_id"; then
        log_upload_step "verify_status=warning verify_error=非法record_id:$record_id"
        return 1
    fi

    if ! is_positive_number "$expected_file_count"; then
        log_upload_step "verify_status=warning verify_error=非法期望文件数量:$expected_file_count"
        return 1
    fi

    if ! curl -fsS -b "$CLOUD_COOKIE_FILE" "$CLOUD_BASE_URL/api/v1/records/$record_id" -o /tmp/defect-cos-record-detail.json; then
        log_upload_step "verify_status=warning verify_error=回查检测记录失败 record_id=$record_id"
        return 1
    fi

    if ! grep -q '"file_kind"[[:space:]]*:[[:space:]]*"source"' /tmp/defect-cos-record-detail.json; then
        log_upload_step "verify_status=warning verify_error=记录详情缺少source record_id=$record_id"
        return 1
    fi

    if ! grep -q '"file_kind"[[:space:]]*:[[:space:]]*"annotated"' /tmp/defect-cos-record-detail.json; then
        log_upload_step "verify_status=warning verify_error=记录详情缺少annotated record_id=$record_id"
        return 1
    fi

    file_count=$(tr ',{}[]' '\n\n\n\n\n' < /tmp/defect-cos-record-detail.json \
        | sed -n 's/^[[:space:]]*"file_kind"[[:space:]]*:.*/x/p' \
        | wc -l \
        | tr -d ' ')
    if [ "$file_count" != "$expected_file_count" ]; then
        log_upload_step "verify_status=warning verify_error=记录详情文件数量异常 record_id=$record_id expected=$expected_file_count actual=$file_count"
        return 1
    fi

    log_upload_step "verify_status=ok record_id=$record_id file_count=$file_count"
    return 0
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --jpg)
            [ "$#" -ge 2 ] || fail "--jpg 缺少路径"
            jpg_file="$2"
            shift 2
            ;;
        --annotated)
            [ "$#" -ge 2 ] || fail "--annotated 缺少路径"
            add_annotated_file "$2"
            shift 2
            ;;
        --png)
            [ "$#" -ge 2 ] || fail "--png 缺少路径"
            add_annotated_file "$2"
            shift 2
            ;;
        -h|--help)
            show_usage
            exit 0
            ;;
        --self-test-json-parser)
            run_json_parser_self_test
            run_time_format_self_test
            run_part_code_self_test
            run_auto_create_part_self_test
            exit 0
            ;;
        --self-test-args)
            run_arg_parser_self_test
            exit 0
            ;;
        *)
            show_usage
            fail "未知参数：$1"
            ;;
    esac
done

[ -n "$jpg_file" ] || fail "缺少 --jpg"
[ -n "$ANNOTATED_FILES" ] || fail "缺少 --annotated"

source_content_type=$(detect_content_type "$jpg_file")
annotated_count=$(printf '%s\n' "$ANNOTATED_FILES" | sed '/^$/d' | wc -l | tr -d ' ')

if [ "$source_content_type" != "image/jpeg" ]; then
    fail "--jpg 只能传入 jpg/jpeg 原图：$jpg_file"
fi

validate_file "$jpg_file" "source"

printf '%s\n' "$ANNOTATED_FILES" | while IFS= read -r annotated_file; do
    [ -n "$annotated_file" ] || continue
    annotated_content_type=$(detect_content_type "$annotated_file")
    validate_file "$annotated_file" "annotated($annotated_content_type)"
done

curl -fsS "$CLOUD_HEALTH_URL" -o /tmp/defect-cos-health.json \
    || fail "云端 health 检查失败：$CLOUD_HEALTH_URL"

validate_cloud_result "$CLOUD_RESULT"
ensure_cloud_session
resolve_cloud_ids
record_id=$(create_record)
created_record_no=$(extract_created_record_no "/tmp/defect-cos-record.json")

if [ -z "$created_record_no" ]; then
    fail "创建检测记录后无法读取 record_no"
fi

prepare_upload "$record_id" "$created_record_no" "source" "source" "$jpg_file" "$source_content_type"
put_to_cos "source" "$jpg_file" "$source_content_type" "$SOURCE_HEADERS"
register_file "$record_id" "source" "source" "$jpg_file" "$source_content_type" "$SOURCE_HEADERS"

annotated_index=0
printf '%s\n' "$ANNOTATED_FILES" | while IFS= read -r annotated_file; do
    [ -n "$annotated_file" ] || continue
    annotated_index=$((annotated_index + 1))
    annotated_tag="annotated-$annotated_index"
    annotated_header_file=$(annotated_header_path "$annotated_index")
    annotated_content_type=$(detect_content_type "$annotated_file")

    prepare_upload "$record_id" "$created_record_no" "annotated" "$annotated_tag" "$annotated_file" "$annotated_content_type"
    put_to_cos "$annotated_tag" "$annotated_file" "$annotated_content_type" "$annotated_header_file"
    register_file "$record_id" "annotated" "$annotated_tag" "$annotated_file" "$annotated_content_type" "$annotated_header_file"
done

if verify_record_detail "$record_id" "$((1 + annotated_count))"; then
    verify_status="ok"
else
    verify_status="warning"
fi

echo "上传成功：upload_status=OK record_id=$record_id record_no=$created_record_no source_kind=source annotated_count=$annotated_count verify_status=$verify_status"
