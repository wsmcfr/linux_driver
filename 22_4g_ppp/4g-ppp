#!/bin/sh

# STM32MP157 4G PPP 拨号管理脚本。
# 这个脚本用于当前 NFS 调试环境，也可以随 rootfs 烧录到板子后继续使用。
# 当前 NFS 调试时 eth0 已经有默认路由，pppd 不会主动替换它，所以脚本会在 ppp0 成功后补一条 4G 默认路由。
# 如果以后系统烧录到 eMMC/SD 后不再依赖 eth0，pppd 的 defaultroute 通常会直接生效；本脚本检测到已有 ppp0 默认路由时不会重复添加。
# 当 ppp0 成功联网后，脚本会调用 board-time-sync 做一次北京时间校准，并把校准后的系统时间写回 RTC。
# SIM 热插拔恢复采用“无卡低频轮询 + 串口 URC 被动唤醒 + 插回短时快速确认”的状态机。
# 当前原理图中 U22 的 USIM_PRESENT 没有接到 Nano SIM 卡座检测脚，因此默认不能依赖硬件插拔中断。

PPP_IF="${PPP_IF:-ppp0}"
PPP_DIR="${PPP_DIR:-/etc/ppp/quectel}"
PPP_ON="${PPP_ON:-$PPP_DIR/ppp-on}"
PPP_TTY="${PPP_TTY:-/dev/ttyUSB2}"
AT_TTY="${AT_TTY:-}"
AT_TTY_CANDIDATES="${AT_TTY_CANDIDATES:-$PPP_TTY /dev/ttyUSB2 /dev/ttyUSB1 /dev/ttyUSB0 /dev/ttyUSB3}"
PPP_BAUD="${PPP_BAUD:-115200}"
LOG_FILE="${LOG_FILE:-/var/log/4g-ppp.log}"
PID_FILE="${PID_FILE:-/var/run/4g-ppp.pid}"
STATE_FILE="${STATE_FILE:-/var/run/4g-ppp.state}"
MONITOR_PID_FILE="${MONITOR_PID_FILE:-/var/run/4g-ppp-monitor.pid}"
CFUN_STAMP_FILE="${CFUN_STAMP_FILE:-/var/run/4g-ppp-cfun.last}"
SIM_ERROR_FAST_STAMP_FILE="${SIM_ERROR_FAST_STAMP_FILE:-/var/run/4g-ppp-sim-error-fast.last}"
WAIT_TTY_SECONDS="${WAIT_TTY_SECONDS:-20}"
WAIT_PPP_SECONDS="${WAIT_PPP_SECONDS:-45}"
PING_HOST="${PING_HOST:-cloud.tencent.com}"
TIME_SYNC_CMD="${TIME_SYNC_CMD:-/usr/bin/board-time-sync}"
BOARD_TIME_ZONE="${BOARD_TIME_ZONE:-CST-8}"
USB_POWER_CONTROLS="${USB_POWER_CONTROLS:-/sys/bus/usb/devices/2-1/power/control /sys/bus/usb/devices/2-1.7/power/control}"
AT_RESPONSE_SECONDS="${AT_RESPONSE_SECONDS:-2}"
AT_PROBE_SECONDS="${AT_PROBE_SECONDS:-1}"
AT_LOCK_DIR="${AT_LOCK_DIR:-/var/run/4g-at.lock}"
AT_LOCK_WAIT_SECONDS="${AT_LOCK_WAIT_SECONDS:-12}"
AT_LOCK_STALE_SECONDS="${AT_LOCK_STALE_SECONDS:-60}"
SIM_PRESENT_WIRED="${SIM_PRESENT_WIRED:-0}"
SIM_RECENT_NO_CARD_INTERVAL="${SIM_RECENT_NO_CARD_INTERVAL:-5}"
SIM_RECENT_NO_CARD_WINDOW_SECONDS="${SIM_RECENT_NO_CARD_WINDOW_SECONDS:-8}"
SIM_LONG_NO_CARD_INTERVAL="${SIM_LONG_NO_CARD_INTERVAL:-8}"
SIM_FAST_RETRY_SECONDS="${SIM_FAST_RETRY_SECONDS:-1}"
SIM_FAST_WAIT_SECONDS="${SIM_FAST_WAIT_SECONDS:-30}"
SIM_ONLINE_CHECK_INTERVAL="${SIM_ONLINE_CHECK_INTERVAL:-30}"
SIM_ONLINE_SIM_CHECK_INTERVAL="${SIM_ONLINE_SIM_CHECK_INTERVAL:-30}"
SIM_ONLINE_PING_TIMEOUT="${SIM_ONLINE_PING_TIMEOUT:-5}"
SIM_UNKNOWN_INTERVAL="${SIM_UNKNOWN_INTERVAL:-8}"
SIM_CFUN_RECOVERY="${SIM_CFUN_RECOVERY:-0}"
SIM_CFUN_ON_SIM_ERROR="${SIM_CFUN_ON_SIM_ERROR:-1}"
SIM_ERROR_FAST_WAIT_SECONDS="${SIM_ERROR_FAST_WAIT_SECONDS:-10}"
SIM_ERROR_FAST_COOLDOWN_SECONDS="${SIM_ERROR_FAST_COOLDOWN_SECONDS:-45}"
SIM_CFUN_SIM_ERROR_COOLDOWN_SECONDS="${SIM_CFUN_SIM_ERROR_COOLDOWN_SECONDS:-30}"
SIM_CFUN_AFTER_NO_CARD_SECONDS="${SIM_CFUN_AFTER_NO_CARD_SECONDS:-120}"
SIM_CFUN_COOLDOWN_SECONDS="${SIM_CFUN_COOLDOWN_SECONDS:-300}"
SIM_AFTER_CFUN_WAIT_SECONDS="${SIM_AFTER_CFUN_WAIT_SECONDS:-8}"
SIM_AFTER_CFUN_READY_WAIT_SECONDS="${SIM_AFTER_CFUN_READY_WAIT_SECONDS:-45}"

# 导出北京时间时区，保证本脚本日志使用板端业务本地时间。
# 只写 /etc/TZ 并不保证当前 BusyBox shell 里的 date 立即按北京时间显示，所以脚本内必须显式导出。
export TZ="$BOARD_TIME_ZONE"

# ONLINE_SIM_STATUS 用于 online_sim_check 通过全局变量把检测结果返回给主循环。
# 不能只依赖 `online_sim_status="$(online_sim_check)"`，因为 POSIX shell 会在命令替换子进程中执行函数，
# 子进程里设置的 AT_TTY 无法回写到主循环，导致日志和状态文件丢失已探测到的辅助 AT 口。
ONLINE_SIM_STATUS=""

log_msg()
{
	# 函数作用：
	#   统一日志格式，既打印到终端，也追加到日志文件。
	#
	# 主要流程：
	#   1. 用 date 生成当前日志时间。
	#   2. 将调用者传入的文本写入 4G PPP 日志。
	#
	# 参数：
	#   $*：需要记录的日志正文。
	#
	# 返回值：
	#   返回 tee 的执行结果；调用方不依赖该返回值。
	printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" | tee -a "$LOG_FILE"
}

now_seconds()
{
	# 函数作用：
	#   输出当前 Unix 秒数，用于计算无卡持续时间和 CFUN 复位冷却时间。
	#
	# 主要流程：
	#   1. 优先调用 `date +%s`。
	#   2. 如果精简系统不支持该格式，则输出 0，让调用方按保守路径处理。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   stdout 输出当前秒数；失败时输出 0。
	date '+%s' 2>/dev/null || echo 0
}

is_ppp_up()
{
	# 函数作用：
	#   判断 ppp0 是否已经创建并处于 UP 状态。
	#
	# 主要流程：
	#   1. 调用 ifconfig 读取 ppp0。
	#   2. BusyBox ifconfig 输出中包含 UP 即认为链路存在。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   0 表示 ppp0 在线；非 0 表示 ppp0 不存在或未 UP。
	ifconfig "$PPP_IF" 2>/dev/null | grep -q 'UP'
}

is_pppd_running()
{
	# 函数作用：
	#   判断 pppd 是否正在运行，避免 AT 检测抢占 PPP 正在使用的串口。
	#
	# 主要流程：
	#   1. 调用 BusyBox 常见的 pidof。
	#   2. 只关心是否存在 pppd PID，不解析具体命令行。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   0 表示 pppd 正在运行；非 0 表示没有 pppd。
	pidof pppd >/dev/null 2>&1
}

get_ppp_ip()
{
	# 函数作用：
	#   从 ppp0 接口信息中提取运营商分配的本地 IP。
	#
	# 主要流程：
	#   1. 兼容 BusyBox `inet addr:` 格式。
	#   2. 兼容 iproute2 风格 `inet` 格式。
	#   3. 找到第一个 IP 后立即输出并退出 awk。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   stdout 输出 IP 字符串；没有 IP 时输出为空。
	ifconfig "$PPP_IF" 2>/dev/null | awk '
		/inet addr:/ {
			gsub("addr:", "", $2);
			print $2;
			exit;
		}
		/inet / {
			print $2;
			exit;
		}
	'
}

has_ppp_default_route()
{
	# 函数作用：
	#   检查默认路由里是否已经有 ppp0。
	#
	# 主要流程：
	#   1. 读取 `ip route show`。
	#   2. 匹配 default 路由是否指向当前 PPP_IF。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   0 表示已有 ppp0 默认路由；非 0 表示没有。
	ip route show 2>/dev/null | grep -q "^default .* dev $PPP_IF"
}

write_state()
{
	# 函数作用：
	#   把 4G/SIM 当前状态写入状态文件，供 Qt、SSH 排障脚本或人工查看。
	#
	# 主要流程：
	#   1. 接收状态名和说明文本。
	#   2. 同步记录更新时间、PPP 接口、PPP IP、串口和 pppd PID。
	#   3. 先写临时文件，再 mv 覆盖，避免读取方看到半截状态。
	#
	# 参数：
	#   $1：状态名，例如 online、no_sim、sim_ready、dial_failed。
	#   $2：状态说明，允许为空。
	#
	# 返回值：
	#   0 表示状态文件写入成功；非 0 表示 /var/run 等路径不可写。
	state_name="$1"
	state_detail="$2"
	state_tmp="$STATE_FILE.$$"

	{
		printf 'state=%s\n' "$state_name"
		printf 'detail=%s\n' "$state_detail"
		printf 'updated_at=%s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
		printf 'ppp_if=%s\n' "$PPP_IF"
		printf 'ppp_ip=%s\n' "$(get_ppp_ip)"
		printf 'ppp_tty=%s\n' "$PPP_TTY"
		printf 'at_tty=%s\n' "$AT_TTY"
		printf 'pppd_pid=%s\n' "$(pidof pppd 2>/dev/null || true)"
	} > "$state_tmp" 2>/dev/null && mv -f "$state_tmp" "$STATE_FILE"
}

ensure_usb_runtime_power()
{
	# 函数作用：
	#   关闭 4G 模块所在 USB hub 链路的 runtime suspend，降低 EC20/Quectel 在运行中被省电策略挂起的概率。
	#
	# 主要流程：
	#   1. 遍历 USB_POWER_CONTROLS 指定的 sysfs power/control 文件。
	#   2. 文件存在时写入 on，要求内核保持该 USB 设备常开。
	#   3. 文件不存在时不报错，因为 4G 模块可能还没有枚举，后续 wait_for_tty 会继续等待 ttyUSB。
	#
	# 参数：
	#   无；可通过环境变量 USB_POWER_CONTROLS 覆盖 sysfs 路径列表。
	#
	# 返回值：
	#   始终返回 0。这个保护失败不能阻止 PPP 排障继续输出真实原因。
	for control in $USB_POWER_CONTROLS; do
		if [ ! -e "$control" ]; then
			continue
		fi

		if echo on > "$control" 2>/dev/null; then
			log_msg "已保持 USB 供电常开：$control=on"
		else
			log_msg "设置 USB 供电常开失败：$control"
		fi
	done

	return 0
}

wait_for_tty()
{
	# 函数作用：
	#   等待 USB 4G 模块枚举出 AT 拨号串口。
	#
	# 主要流程：
	#   1. 最多等待 WAIT_TTY_SECONDS 秒。
	#   2. 每秒检查一次 PPP_TTY 是否为字符设备。
	#   3. 超时后记录日志并返回失败。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   0 表示串口存在；1 表示等待超时。
	i=0
	while [ "$i" -lt "$WAIT_TTY_SECONDS" ]; do
		ensure_usb_runtime_power
		if [ -c "$PPP_TTY" ]; then
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done

	log_msg "未发现 $PPP_TTY，跳过 4G PPP 拨号"
	write_state "no_tty" "未发现 $PPP_TTY"
	return 1
}

remove_at_lock_dir()
{
	# 函数作用：
	#   安全删除共享 AT 锁目录，避免 AT_LOCK_DIR 被误配置时删除非锁路径。
	#
	# 主要流程：
	#   1. 只允许删除路径末尾为 `4g-at.lock` 的锁目录。
	#   2. 路径为空、根目录、`/var/run` 这类非锁目录时拒绝删除并写日志。
	#
	# 参数：
	#   无；使用全局 AT_LOCK_DIR。
	#
	# 返回值：
	#   0 表示删除完成或路径不存在；1 表示路径不符合安全约束。
	case "$AT_LOCK_DIR" in
		*/4g-at.lock)
			rm -rf "$AT_LOCK_DIR" 2>/dev/null || true
			return 0
			;;
		*)
			log_msg "拒绝删除非 4G AT 锁目录：$AT_LOCK_DIR" >/dev/null
			return 1
			;;
	esac
}

acquire_at_lock()
{
	# 函数作用：
	#   获取 4G 模块 AT 管理口的跨脚本互斥锁，避免 4g-ppp monitor 和 4g-location 同时读写同一个 ttyUSB。
	#
	# 主要流程：
	#   1. 使用 `mkdir` 创建锁目录；BusyBox 环境中目录创建具备原子性，不依赖 flock。
	#   2. 成功后写入 owner、pid、created_at 和 reason，方便板端 SSH 排查锁归属。
	#   3. 如果锁已存在，检查 created_at；超过 AT_LOCK_STALE_SECONDS 的陈旧锁会被清理。
	#   4. 最多等待 AT_LOCK_WAIT_SECONDS，超时后返回失败，让 monitor 下轮继续观察。
	#
	# 参数：
	#   $1：锁用途说明，例如 `AT+CPIN? on /dev/ttyUSB3`。
	#
	# 返回值：
	#   0 表示成功持有锁；1 表示等待超时未拿到锁。
	lock_reason="$1"
	lock_start="$(now_seconds)"

	while :; do
		if mkdir "$AT_LOCK_DIR" 2>/dev/null; then
			{
				printf 'owner=4g-ppp\n'
				printf 'pid=%s\n' "$$"
				printf 'created_at=%s\n' "$(now_seconds)"
				printf 'reason=%s\n' "$lock_reason"
			} > "$AT_LOCK_DIR/info" 2>/dev/null || true
			return 0
		fi

		lock_now="$(now_seconds)"
		lock_created="$(sed -n 's/^created_at=//p' "$AT_LOCK_DIR/info" 2>/dev/null | head -n 1)"
		case "$lock_created" in
			''|*[!0-9]*)
				lock_created=0
				;;
		esac

		if [ "$lock_created" -gt 0 ] &&
				[ $((lock_now - lock_created)) -ge "$AT_LOCK_STALE_SECONDS" ]; then
			log_msg "清理陈旧 AT 串口锁：$AT_LOCK_DIR" >/dev/null
			remove_at_lock_dir || return 1
			continue
		fi

		if [ $((lock_now - lock_start)) -ge "$AT_LOCK_WAIT_SECONDS" ]; then
			log_msg "等待 AT 串口锁超时：$AT_LOCK_DIR，reason=$lock_reason" >/dev/null
			return 1
		fi

		sleep 1
	done
}

release_at_lock()
{
	# 函数作用：
	#   释放当前 4g-ppp 进程持有的 AT 串口锁。
	#
	# 主要流程：
	#   1. 读取锁目录中的 pid。
	#   2. 只有 pid 等于当前脚本 PID 时才删除，避免误删其它进程刚获得的新锁。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   始终返回 0；释放失败不影响 PPP 主状态机继续运行。
	lock_pid="$(sed -n 's/^pid=//p' "$AT_LOCK_DIR/info" 2>/dev/null | head -n 1)"
	if [ "$lock_pid" = "$$" ]; then
		remove_at_lock_dir || true
	fi
	return 0
}

at_exchange_on_tty()
{
	# 函数作用：
	#   在指定 ttyUSB 串口上发送一条 AT 命令，并在短超时时间内收集返回文本。
	#
	# 主要流程：
	#   1. 确认调用者指定的 AT 串口存在。
	#   2. 如果 pppd 正在运行，拒绝访问串口，防止抢占 PPP 数据通道。
	#   3. 临时配置串口为 115200 raw 模式，发送 AT 命令。
	#   4. 使用 timeout 读取响应，避免脚本永久阻塞。
	#   5. 恢复原串口配置并删除临时响应文件。
	#
	# 参数：
	#   $1：实际发送 AT 命令的 ttyUSB 设备节点，例如 /dev/ttyUSB2。
	#   $2：AT 命令正文，不需要包含结尾回车。
	#   $3：读取响应的最大秒数，省略时使用 AT_RESPONSE_SECONDS。
	#   $4：是否允许 pppd 运行时访问非 PPP_TTY 辅助口；1 表示允许，默认 0。
	#
	# 返回值：
	#   0 表示命令已发送并读取到本轮响应窗口；1 表示串口不可用或写入失败；2 表示 pppd 正在占用串口。
	at_device="$1"
	at_cmd="$2"
	at_timeout="${3:-$AT_RESPONSE_SECONDS}"
	at_allow_while_pppd="${4:-0}"
	at_tmp="/tmp/4g-ppp-at.$$.${at_device##*/}"

	if [ ! -c "$at_device" ]; then
		return 1
	fi

	if is_pppd_running && { [ "$at_allow_while_pppd" != "1" ] || [ "$at_device" = "$PPP_TTY" ]; }; then
		return 2
	fi

	if ! acquire_at_lock "$at_cmd on $at_device"; then
		return 1
	fi

	old_stty="$(stty -F "$at_device" -g 2>/dev/null || true)"
	stty -F "$at_device" "$PPP_BAUD" raw -echo -crtscts 2>/dev/null || true
	rm -f "$at_tmp"

	cat "$at_device" > "$at_tmp" 2>/dev/null &
	at_cat_pid="$!"
	sleep 1

	if ! printf '%s\r' "$at_cmd" > "$at_device" 2>/dev/null; then
		kill "$at_cat_pid" 2>/dev/null || true
		wait "$at_cat_pid" 2>/dev/null || true
		if [ -n "$old_stty" ]; then
			stty -F "$at_device" "$old_stty" 2>/dev/null || true
		fi
		rm -f "$at_tmp"
		release_at_lock
		return 1
	fi

	sleep "$at_timeout"
	kill "$at_cat_pid" 2>/dev/null || true
	wait "$at_cat_pid" 2>/dev/null || true

	if [ -n "$old_stty" ]; then
		stty -F "$at_device" "$old_stty" 2>/dev/null || true
	fi

	cat "$at_tmp" 2>/dev/null || true
	rm -f "$at_tmp"
	release_at_lock
	return 0
}

find_at_tty()
{
	# 函数作用：
	#   从候选 ttyUSB 列表中找到当前能响应基础 AT 命令的管理口。
	#
	# 主要流程：
	#   1. 如果 AT_TTY 已经设置且仍能响应 AT，则直接复用，减少每轮探测成本。
	#   2. 按 AT_TTY_CANDIDATES 顺序尝试 `/dev/ttyUSB2/1/0/3` 等候选口。
	#   3. 每个候选口只发送一次 `AT`，收到 `OK` 就记录为新的 AT_TTY。
	#   4. 如果没有任何口响应，返回失败，外层 monitor 按低频 unknown 路径继续。
	#
	# 参数：
	#   无；候选列表由 AT_TTY_CANDIDATES 环境变量提供。
	#
	# 返回值：
	#   0 表示找到并写入全局 AT_TTY；1 表示没有可用 AT 口；2 表示 pppd 正在占用串口。
	if is_pppd_running; then
		return 2
	fi

	if [ -n "$AT_TTY" ] && [ -c "$AT_TTY" ]; then
		probe_response="$(at_exchange_on_tty "$AT_TTY" 'AT' "$AT_PROBE_SECONDS")"
		probe_rc="$?"
		if [ "$probe_rc" -eq 0 ] && printf '%s\n' "$probe_response" | grep -Fq 'OK'; then
			return 0
		fi
	fi

	probed_ttys=" "
	for candidate_tty in $AT_TTY_CANDIDATES; do
		if [ -z "$candidate_tty" ]; then
			continue
		fi

		case "$probed_ttys" in
			*" $candidate_tty "*)
				continue
				;;
		esac
		probed_ttys="${probed_ttys}${candidate_tty} "

		if [ ! -c "$candidate_tty" ]; then
			continue
		fi

		probe_response="$(at_exchange_on_tty "$candidate_tty" 'AT' "$AT_PROBE_SECONDS" 1)"
		probe_rc="$?"

		if [ "$probe_rc" -eq 2 ]; then
			return 2
		fi

		if [ "$probe_rc" -eq 0 ] && printf '%s\n' "$probe_response" | grep -Fq 'OK'; then
			AT_TTY="$candidate_tty"
			log_msg "已探测到可用 AT 查询口：$AT_TTY" >/dev/null
			return 0
		fi
	done

	AT_TTY=""
	return 1
}

find_aux_at_tty()
{
	# 函数作用：
	#   在 pppd 在线占用 PPP_TTY 时，寻找一个不会抢占 PPP 数据口的 AT 管理口。
	#
	# 主要流程：
	#   1. 遍历 AT_TTY_CANDIDATES。
	#   2. 跳过当前 PPP_TTY，避免在线健康检测破坏 PPP 数据流。
	#   3. 对其它 ttyUSB 候选口发送基础 `AT`，收到 `OK` 后记录到 AT_TTY。
	#   4. 没有辅助 AT 口时返回失败，调用方按保守路径继续观察 ppp0。
	#
	# 参数：
	#   无；候选列表由 AT_TTY_CANDIDATES 环境变量提供。
	#
	# 返回值：
	#   0 表示找到辅助 AT 口；1 表示没有可用辅助 AT 口。
	probed_ttys=" "
	for candidate_tty in $AT_TTY_CANDIDATES; do
		if [ -z "$candidate_tty" ]; then
			continue
		fi

		if [ "$candidate_tty" = "$PPP_TTY" ]; then
			continue
		fi

		case "$probed_ttys" in
			*" $candidate_tty "*)
				continue
				;;
		esac
		probed_ttys="${probed_ttys}${candidate_tty} "

		if [ ! -c "$candidate_tty" ]; then
			continue
		fi

		probe_response="$(at_exchange_on_tty "$candidate_tty" 'AT' "$AT_PROBE_SECONDS" 1)"
		probe_rc="$?"

		if [ "$probe_rc" -eq 0 ] && printf '%s\n' "$probe_response" | grep -Fq 'OK'; then
			AT_TTY="$candidate_tty"
			log_msg "已探测到辅助 AT 查询口：$AT_TTY" >/dev/null
			return 0
		fi
	done

	return 1
}

at_exchange()
{
	# 函数作用：
	#   自动选择当前可用 AT 查询口，然后发送 AT 命令并返回响应。
	#
	# 主要流程：
	#   1. 调用 find_at_tty 找到可响应 `AT` 的管理口。
	#   2. 用该管理口发送调用者指定的 AT 命令。
	#   3. 如果缓存 AT_TTY 本轮失效，则清空缓存，下一轮重新探测。
	#
	# 参数：
	#   $1：AT 命令正文，不需要包含结尾回车。
	#   $2：读取响应的最大秒数，省略时使用 AT_RESPONSE_SECONDS。
	#
	# 返回值：
	#   0 表示命令已发送并读取响应；1 表示没有可用 AT 口或写入失败；2 表示 pppd 正在占用串口。
	at_cmd="$1"
	at_timeout="${2:-$AT_RESPONSE_SECONDS}"
	find_at_tty
	find_rc="$?"

	if [ "$find_rc" -ne 0 ]; then
		return "$find_rc"
	fi

	at_exchange_on_tty "$AT_TTY" "$at_cmd" "$at_timeout"
	at_rc="$?"
	if [ "$at_rc" -ne 0 ]; then
		AT_TTY=""
	fi

	return "$at_rc"
}

enable_sim_hotplug_detection()
{
	# 函数作用：
	#   在硬件接好 USIM_PRESENT 检测脚时，启用 Quectel SIM 插拔 URC 上报。
	#
	# 主要流程：
	#   1. 检查 SIM_PRESENT_WIRED 是否为 1。
	#   2. 当前原理图没有把 USIM_PRESENT 接到 Nano SIM 卡座检测脚，默认跳过。
	#   3. 如果后续硬件飞线或改板接好了检测脚，再发送 QSIMSTAT/QSIMDET 启用上报。
	#
	# 参数：
	#   无；通过 SIM_PRESENT_WIRED=1 显式开启硬件检测路径。
	#
	# 返回值：
	#   始终返回 0，硬件检测不可用时脚本继续走低频轮询兜底。
	if [ "$SIM_PRESENT_WIRED" != "1" ]; then
		log_msg "SIM_PRESENT_WIRED=0：原理图未接 USIM_PRESENT，使用低频轮询和 URC 被动监听"
		return 0
	fi

	at_exchange 'AT+QSIMSTAT=1' 2 >/dev/null 2>&1 || true
	at_exchange 'AT+QSIMDET=1,0' 2 >/dev/null 2>&1 || true
	log_msg "已尝试启用 Quectel SIM 热插拔上报：AT+QSIMSTAT=1, AT+QSIMDET=1,0"
	return 0
}

query_sim_status()
{
	# 函数作用：
	#   查询 SIM 当前状态，并输出归一化状态名。
	#
	# 主要流程：
	#   1. 发送 AT+CPIN?。
	#   2. 将 +CPIN: READY 归一化为 ready。
	#   3. 将 +CME ERROR: 10、NOT INSERTED、未插卡类文本归一化为 no_sim。
	#   4. 将 +CME ERROR: 13 归一化为 sim_error，用于触发低频 SIM 重新初始化兜底。
	#   5. 将 SIM PIN/SIM PUK 归一化为 pin_required。
	#   6. 其他响应归一化为 unknown，便于监控循环低频重试。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   stdout 输出 ready、no_sim、sim_error、pin_required、pppd_busy、tty_missing 或 unknown。
	sim_response="$(at_exchange 'AT+CPIN?' "$AT_RESPONSE_SECONDS")"
	sim_rc="$?"

	if [ "$sim_rc" -eq 2 ]; then
		echo "pppd_busy"
		return 2
	fi

	if [ "$sim_rc" -ne 0 ]; then
		if [ -z "$AT_TTY" ]; then
			echo "tty_missing"
			return 1
		fi

		echo "unknown"
		return 1
	fi

	if printf '%s\n' "$sim_response" | grep -Fq '+CPIN: READY'; then
		echo "ready"
		return 0
	fi

	if printf '%s\n' "$sim_response" | grep -Eiq 'SIM PIN|SIM PUK'; then
		echo "pin_required"
		return 1
	fi

	if printf '%s\n' "$sim_response" | grep -Eiq '\+CME ERROR: *13'; then
		echo "sim_error"
		return 1
	fi

	if printf '%s\n' "$sim_response" | grep -Eiq '\+CME ERROR: *10|NOT INSERTED|NO SIM|SIM.*REMOVED'; then
		echo "no_sim"
		return 1
	fi

	echo "unknown"
	return 1
}

online_sim_check()
{
	# 函数作用：
	#   PPP 在线时用辅助 AT 管理口确认 SIM 是否已经被拔出，让 UI 能在约 30 秒内切到离线。
	#
	# 主要流程：
	#   1. 只寻找非 PPP_TTY 的辅助 AT 口，避免破坏正在传输数据的 PPP 串口。
	#   2. 辅助口可用时发送 `AT+CPIN?`。
	#   3. 返回 `no_sim` 时说明 SIM 已经不在位或模块报 SIM 故障，调用方应主动停止 pppd。
	#   4. 辅助口不存在或返回 unknown 时，不主动断线，继续依赖 ppp0/LCP 自然状态。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   stdout 和 ONLINE_SIM_STATUS 输出 ready、no_sim、sim_error、pin_required、unknown 或 skipped。
	#   0 表示 SIM 仍可用；1 表示检测到无卡或未知；2 表示本轮没有辅助口，跳过。
	if ! find_aux_at_tty; then
		ONLINE_SIM_STATUS="skipped"
		echo "skipped"
		return 2
	fi

	sim_response="$(at_exchange_on_tty "$AT_TTY" 'AT+CPIN?' "$AT_RESPONSE_SECONDS" 1)"
	sim_rc="$?"

	if [ "$sim_rc" -ne 0 ]; then
		ONLINE_SIM_STATUS="unknown"
		echo "unknown"
		return 1
	fi

	if printf '%s\n' "$sim_response" | grep -Fq '+CPIN: READY'; then
		ONLINE_SIM_STATUS="ready"
		echo "ready"
		return 0
	fi

	if printf '%s\n' "$sim_response" | grep -Eiq 'SIM PIN|SIM PUK'; then
		ONLINE_SIM_STATUS="pin_required"
		echo "pin_required"
		return 1
	fi

	if printf '%s\n' "$sim_response" | grep -Eiq '\+CME ERROR: *13'; then
		ONLINE_SIM_STATUS="sim_error"
		echo "sim_error"
		return 1
	fi

	if printf '%s\n' "$sim_response" | grep -Eiq '\+CME ERROR: *10|NOT INSERTED|NO SIM|SIM.*REMOVED'; then
		ONLINE_SIM_STATUS="no_sim"
		echo "no_sim"
		return 1
	fi

	ONLINE_SIM_STATUS="unknown"
	echo "unknown"
	return 1
}

online_link_check()
{
	# 函数作用：
	#   PPP 在线时验证 4G 数据链路是否仍能真正出网，用于比 LCP 更快发现拔卡后的离线。
	#
	# 主要流程：
	#   1. 使用 BusyBox ping 的 `-I ppp0` 指定 4G 接口，避免 eth0/NFS 路由误判在线。
	#   2. 使用 `-W` 限制等待时间，默认 5 秒，避免健康检测长时间阻塞 monitor。
	#   3. 不退化为普通 ping，因为普通 ping 可能走 eth0 成功，导致拔卡后仍误显示 4G 在线。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   0 表示 4G 数据链路可达；1 表示本轮健康检测失败。
	if ping -I "$PPP_IF" -c 1 -W "$SIM_ONLINE_PING_TIMEOUT" "$PING_HOST" >/dev/null 2>&1; then
		return 0
	fi

	return 1
}

print_sim_status()
{
	# 函数作用：
	#   给人工排障输出 SIM 状态、AT 原始响应和当前缓存状态文件。
	#
	# 主要流程：
	#   1. 如果 pppd 正在运行，说明不能安全抢占 AT 串口。
	#   2. 如果 pppd 未运行，则发送 AT+CPIN? 并打印原始响应。
	#   3. 如果存在状态文件，一并输出 monitor 最近一次记录。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   0 表示命令完成；非 0 表示串口不存在或 pppd 正在占用。
	ensure_usb_runtime_power

	if is_pppd_running; then
		echo "sim_status=pppd_busy"
		echo "detail=pppd 正在运行，不能抢占 $PPP_TTY 查询 SIM；请先看 $PPP_IF 或执行 4g-ppp stop"
		return 2
	fi

	find_at_tty
	find_rc="$?"

	if [ "$find_rc" -eq 2 ]; then
		echo "sim_status=pppd_busy"
		echo "detail=pppd 正在运行，不能抢占 AT 串口查询 SIM；请先看 $PPP_IF 或执行 4g-ppp stop"
		return 2
	fi

	if [ "$find_rc" -ne 0 ]; then
		echo "sim_status=tty_missing"
		echo "detail=未找到可响应 AT 的 ttyUSB 查询口；候选列表：$AT_TTY_CANDIDATES"
		return 1
	fi

	echo "at_tty=$AT_TTY"
	echo "---- normalized sim status ----"
	query_sim_status || true
	echo "---- raw AT+CPIN? response ----"
	at_exchange_on_tty "$AT_TTY" 'AT+CPIN?' "$AT_RESPONSE_SECONDS" || true

	if [ -f "$STATE_FILE" ]; then
		echo "---- cached monitor state ----"
		cat "$STATE_FILE"
	fi
}

wait_for_sim_ready()
{
	# 函数作用：
	#   在插卡后短时间快速确认 SIM 是否初始化完成。
	#
	# 主要流程：
	#   1. 每 SIM_FAST_RETRY_SECONDS 秒查询一次 SIM 状态。
	#   2. 默认最多等待 SIM_FAST_WAIT_SECONDS 秒，调用方也可以传入更短或更长的等待时间。
	#   3. 查询到 ready 后立即返回成功。
	#   4. 查询到 no_sim 或 unknown 时继续短时等待；查询到 PIN/PUK 时直接失败。
	#
	# 参数：
	#   $1：可选，覆盖本次最多等待的秒数；为空时使用 SIM_FAST_WAIT_SECONDS。
	#
	# 返回值：
	#   0 表示 SIM 已 READY；1 表示等待超时、需要 PIN/PUK 或串口不可用。
	ready_wait_seconds="${1:-$SIM_FAST_WAIT_SECONDS}"
	ready_wait_started="$(now_seconds)"
	elapsed=0
	while [ "$elapsed" -lt "$ready_wait_seconds" ]; do
		sim_status="$(query_sim_status)"

		case "$sim_status" in
			ready)
				log_msg "SIM 已就绪：AT+CPIN? -> READY"
				write_state "sim_ready" "SIM 已 READY，准备拨号"
				return 0
				;;
			pin_required)
				log_msg "SIM 需要 PIN/PUK，不能自动拨号"
				write_state "sim_pin_required" "SIM 需要 PIN/PUK"
				return 1
				;;
			pppd_busy)
				log_msg "pppd 正在运行，等待 SIM READY 时不能抢占 $PPP_TTY"
				write_state "pppd_busy" "pppd 正在运行"
				return 1
				;;
			tty_missing)
				log_msg "等待 SIM READY 时未发现 $PPP_TTY"
				write_state "no_tty" "等待 SIM READY 时未发现 $PPP_TTY"
				return 1
				;;
			*)
				log_msg "SIM 尚未就绪：$sim_status，${SIM_FAST_RETRY_SECONDS}s 后重试"
				;;
		esac

		sleep "$SIM_FAST_RETRY_SECONDS"
		ready_wait_now="$(now_seconds)"
		if [ "$ready_wait_started" -gt 0 ] && [ "$ready_wait_now" -gt 0 ]; then
			elapsed=$((ready_wait_now - ready_wait_started))
		else
			elapsed=$((elapsed + SIM_FAST_RETRY_SECONDS))
		fi
	done

	log_msg "等待 SIM READY 超时：${ready_wait_seconds}s"
	write_state "sim_wait_timeout" "等待 SIM READY 超时"
	return 1
}

wait_for_sim_urc_or_timeout()
{
	# 函数作用：
	#   在无卡低频等待期间被动监听串口 URC，尽量做到插卡后立即唤醒。
	#
	# 主要流程：
	#   1. 不发送任何 AT 命令，只读取串口输出。
	#   2. 如果模块主动输出 +CPIN: READY、+QSIMSTAT: 1 或 SIM 插入类文本，则立即返回成功。
	#   3. 如果超时期间没有 URC，则返回失败，外层循环再做一次低频主动 AT 查询。
	#
	# 参数：
	#   $1：本次被动等待的最大秒数。
	#
	# 返回值：
	#   0 表示监听到疑似插卡/READY URC；1 表示没有事件或串口不可用。
	urc_timeout="$1"

	find_at_tty
	find_rc="$?"
	if [ "$find_rc" -ne 0 ]; then
		return 1
	fi

	if is_pppd_running; then
		return 1
	fi

	if ! acquire_at_lock "SIM URC listen on $AT_TTY"; then
		return 1
	fi

	old_stty="$(stty -F "$AT_TTY" -g 2>/dev/null || true)"
	stty -F "$AT_TTY" "$PPP_BAUD" raw -echo -crtscts 2>/dev/null || true

	if command -v timeout >/dev/null 2>&1; then
		timeout "$urc_timeout" awk '
			{
				line = tolower($0);
				if (index(line, "+cpin: ready") || index(line, "+qsimstat: 1") || (index(line, "sim") && index(line, "insert"))) {
					found = 1;
					exit;
				}
			}
			END {
				if (found) {
					exit 0;
				}
				exit 1;
			}
		' < "$AT_TTY"
		urc_rc="$?"
	else
		sleep "$urc_timeout"
		urc_rc=1
	fi

	if [ -n "$old_stty" ]; then
		stty -F "$AT_TTY" "$old_stty" 2>/dev/null || true
	fi
	release_at_lock

	if [ "$urc_rc" -eq 0 ]; then
		log_msg "监听到 SIM 插入/READY URC，进入快速确认"
		write_state "sim_urc" "监听到 SIM 插入/READY URC"
		return 0
	fi

	return 1
}

try_sim_error_fast_ready()
{
	# 函数作用：
	#   在 AT+CPIN? 返回 sim_error 时，先用轻量快速查询确认 SIM 是否已经自然恢复，避免一上来就 CFUN 重初始化。
	#
	# 主要流程：
	#   1. 读取 SIM 错误快速确认的时间戳，避免同一个接触不良状态下频繁 1 秒查询。
	#   2. 如果冷却时间未到，直接返回失败，让外层按 8 秒低频轮询继续。
	#   3. 冷却允许时，调用 wait_for_sim_ready 做短时间 1 秒一次确认。
	#   4. 一旦 SIM READY，立即返回成功，外层可以直接拨号，不必再执行 CFUN=0/1。
	#
	# 参数：
	#   无；通过 SIM_ERROR_FAST_WAIT_SECONDS 和 SIM_ERROR_FAST_COOLDOWN_SECONDS 控制等待和冷却。
	#
	# 返回值：
	#   0 表示 SIM 已在轻量确认阶段 READY；1 表示仍未 READY 或本轮跳过快速确认。
	now="$(now_seconds)"
	last=0

	if [ -f "$SIM_ERROR_FAST_STAMP_FILE" ]; then
		last="$(cat "$SIM_ERROR_FAST_STAMP_FILE" 2>/dev/null || echo 0)"
	fi

	if [ "$now" -gt 0 ] && [ "$last" -gt 0 ] && [ $((now - last)) -lt "$SIM_ERROR_FAST_COOLDOWN_SECONDS" ]; then
		log_msg "SIM 错误快速确认仍在冷却期，继续按 ${SIM_LONG_NO_CARD_INTERVAL}s 低频检测"
		return 1
	fi

	echo "$now" > "$SIM_ERROR_FAST_STAMP_FILE" 2>/dev/null || true
	log_msg "SIM 返回错误状态，先快速确认 ${SIM_ERROR_FAST_WAIT_SECONDS}s，避免立即 CFUN 重初始化"
	write_state "sim_error_fast_wait" "SIM 错误后先快速确认 READY"

	if wait_for_sim_ready "$SIM_ERROR_FAST_WAIT_SECONDS"; then
		log_msg "SIM 错误状态已自然恢复为 READY，跳过 CFUN 直接拨号"
		return 0
	fi

	log_msg "SIM 错误快速确认未恢复，允许后续按冷却策略执行 CFUN 兜底"
	return 1
}

try_sim_cfun_reinit()
{
	# 函数作用：
	#   可选地通过 AT+CFUN=0/1 触发模块重新初始化 SIM/RF，作为无卡状态长期不恢复时的低频兜底。
	#
	# 主要流程：
	#   1. 默认 SIM_CFUN_RECOVERY=0，不主动复位模块，避免用户长时间未插卡时反复扰动模块。
	#   2. 根据触发原因选择冷却时间：sim_error 用较短冷却，长期无卡仍用较长冷却。
	#   3. 依次发送 AT+CFUN=0 和 AT+CFUN=1，然后等待模块重新初始化。
	#
	# 参数：
	#   $1：触发原因；sim_error 表示插回后模块报 SIM 错误，long_no_card 表示长期无卡兜底。
	#
	# 返回值：
	#   0 表示已经尝试 CFUN；1 表示未开启、冷却未到或串口不可用。
	cfun_reason="${1:-long_no_card}"
	cfun_cooldown="$SIM_CFUN_COOLDOWN_SECONDS"

	if [ "$SIM_CFUN_RECOVERY" != "1" ] && { [ "$SIM_CFUN_ON_SIM_ERROR" != "1" ] || [ "$cfun_reason" != "sim_error" ]; }; then
		return 1
	fi

	if [ "$cfun_reason" = "sim_error" ]; then
		cfun_cooldown="$SIM_CFUN_SIM_ERROR_COOLDOWN_SECONDS"
	fi

	now="$(now_seconds)"
	last=0
	if [ -f "$CFUN_STAMP_FILE" ]; then
		last="$(cat "$CFUN_STAMP_FILE" 2>/dev/null || echo 0)"
	fi

	if [ "$now" -gt 0 ] && [ "$last" -gt 0 ] && [ $((now - last)) -lt "$cfun_cooldown" ]; then
		log_msg "CFUN 重新初始化仍在冷却期：reason=$cfun_reason，剩余约 $((cfun_cooldown - (now - last)))s"
		return 1
	fi

	echo "$now" > "$CFUN_STAMP_FILE" 2>/dev/null || true
	log_msg "尝试低频 CFUN 重新初始化 SIM：reason=$cfun_reason, AT+CFUN=0/1"
	write_state "sim_cfun_reinit" "尝试 AT+CFUN=0/1 重新初始化 SIM，reason=$cfun_reason"
	at_exchange 'AT+CFUN=0' 3 >/dev/null 2>&1 || true
	sleep 3
	at_exchange 'AT+CFUN=1' 5 >/dev/null 2>&1 || true
	sleep "$SIM_AFTER_CFUN_WAIT_SECONDS"
	return 0
}

clear_sim_recovery_stamps()
{
	# 函数作用：
	#   PPP 成功上线后清理本轮 SIM 恢复时间戳，让下一次拔插测试作为新的恢复周期处理。
	#
	# 主要流程：
	#   1. 删除 SIM 错误快速确认时间戳。
	#   2. 删除 CFUN 复位时间戳。
	#   3. 删除失败不影响 PPP 在线状态，因此只记录为宽松清理动作。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   始终返回 0。
	rm -f "$SIM_ERROR_FAST_STAMP_FILE" "$CFUN_STAMP_FILE" 2>/dev/null || true
	return 0
}

wait_for_ppp()
{
	# 函数作用：
	#   等待 pppd 完成 AT 拨号、CHAP 认证和 IPCP 地址协商。
	#
	# 主要流程：
	#   1. 最多等待 WAIT_PPP_SECONDS 秒。
	#   2. 每秒检查 ppp0 是否 UP 且已经分配 IP。
	#   3. 超时后提示查看详细日志。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   0 表示 PPP 已经拿到 IP；1 表示等待超时。
	i=0
	while [ "$i" -lt "$WAIT_PPP_SECONDS" ]; do
		if is_ppp_up && [ -n "$(get_ppp_ip)" ]; then
			return 0
		fi
		sleep 1
		i=$((i + 1))
	done

	log_msg "等待 $PPP_IF 获取 IP 超时，请查看 $LOG_FILE"
	write_state "ppp_wait_timeout" "等待 $PPP_IF 获取 IP 超时"
	return 1
}

ensure_default_route()
{
	# 函数作用：
	#   确保公网默认流量可以走 4G PPP 链路。
	#
	# 主要流程：
	#   1. 读取 ppp0 当前本地 IP。
	#   2. 如果已有 ppp0 默认路由则直接返回成功。
	#   3. 优先用 route add default gw 添加默认路由。
	#   4. route 失败时再尝试 ip route add default dev。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   0 表示默认路由可用；1 表示无法添加默认路由。
	ppp_ip="$(get_ppp_ip)"

	if [ -z "$ppp_ip" ]; then
		log_msg "$PPP_IF 还没有本地 IP，不能添加默认路由"
		return 1
	fi

	if has_ppp_default_route; then
		log_msg "默认路由已经指向 $PPP_IF，无需重复添加"
		return 0
	fi

	if route add default gw "$ppp_ip" 2>/dev/null; then
		log_msg "已添加 4G 默认路由：default via $ppp_ip dev $PPP_IF"
		return 0
	fi

	if ip route add default dev "$PPP_IF" 2>/dev/null; then
		log_msg "已添加 4G 默认路由：default dev $PPP_IF"
		return 0
	fi

	log_msg "添加 4G 默认路由失败，请手动检查：ip route show"
	return 1
}

sync_board_time()
{
	# 函数作用：
	#   PPP 联网成功后做一次板端北京时间校准。
	#
	# 主要流程：
	#   1. 检查 board-time-sync 是否存在且可执行。
	#   2. 执行 `board-time-sync once`。
	#   3. 校时失败时只记录日志，不影响 4G PPP start 的成功返回。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   始终返回 0，避免校时服务器短暂失败导致拨号被误判失败。
	if [ ! -x "$TIME_SYNC_CMD" ]; then
		log_msg "未找到校时脚本：$TIME_SYNC_CMD，跳过开机校时"
		return 0
	fi

	if "$TIME_SYNC_CMD" once >>"$LOG_FILE" 2>&1; then
		log_msg "联网后北京时间校准完成"
	else
		log_msg "联网后北京时间校准失败，请查看 /var/log/board-time-sync.log"
	fi

	return 0
}

start_ppp()
{
	# 函数作用：
	#   启动 4G PPP 拨号，并在联网成功后触发一次板端校时。
	#
	# 主要流程：
	#   1. 如果 ppp0 已在线，则补默认路由并校时。
	#   2. 否则等待串口，先快速确认 SIM READY。
	#   3. SIM 就绪后执行 ppp-on、等待 ppp0 获取 IP。
	#   4. ppp0 获取 IP 后补默认路由。
	#   5. 默认路由可用后调用 board-time-sync 校准系统时间和 RTC。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   0 表示 PPP 链路和默认路由处理成功；非 0 表示拨号、SIM 或路由失败。
	ensure_usb_runtime_power

	if is_ppp_up && [ -n "$(get_ppp_ip)" ]; then
		log_msg "$PPP_IF 已经在线，本地 IP：$(get_ppp_ip)"
		write_state "online" "$PPP_IF 已经在线"
		clear_sim_recovery_stamps
		ensure_default_route || return 1
		sync_board_time
		return 0
	fi

	if [ ! -x "$PPP_ON" ]; then
		log_msg "找不到可执行拨号脚本：$PPP_ON"
		write_state "missing_ppp_on" "找不到可执行拨号脚本：$PPP_ON"
		return 1
	fi

	wait_for_tty || return 1
	enable_sim_hotplug_detection
	wait_for_sim_ready || return 1

	log_msg "开始 4G PPP 拨号，日志：$LOG_FILE"
	cd "$PPP_DIR" || return 1

	# 使用 nohup 后台运行 ppp-on；ppp-on 内部 exec pppd，pppd 的详细日志会写入 LOG_FILE。
	nohup "$PPP_ON" >>"$LOG_FILE" 2>&1 < /dev/null &
	echo "$!" > "$PID_FILE"

	wait_for_ppp || return 1
	log_msg "$PPP_IF 已上线，本地 IP：$(get_ppp_ip)"
	write_state "online" "$PPP_IF 已上线，本地 IP：$(get_ppp_ip)"
	clear_sim_recovery_stamps
	ensure_default_route || return 1
	sync_board_time
}

stop_ppp()
{
	# 函数作用：
	#   停止 pppd，并清理脚本添加过的 ppp0 默认路由。
	#
	# 主要流程：
	#   1. 尝试根据当前 ppp0 IP 删除 route 默认路由。
	#   2. 再尝试删除 iproute2 风格的默认路由。
	#   3. killall pppd 释放 PPP 进程。
	#   4. 删除 PID 文件。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   函数本身不强制失败；没有 pppd 时也记录为可接受状态。
	ppp_ip="$(get_ppp_ip)"

	if [ -n "$ppp_ip" ]; then
		route del default gw "$ppp_ip" 2>/dev/null
	fi

	ip route del default dev "$PPP_IF" 2>/dev/null

	if killall pppd 2>/dev/null; then
		log_msg "已停止 pppd"
	else
		log_msg "没有正在运行的 pppd"
	fi

	rm -f "$PID_FILE"
	write_state "stopped" "pppd 已停止"
}

status_ppp()
{
	# 函数作用：
	#   输出 PPP 接口、路由、pppd 进程、SIM 监控状态和校时状态。
	#
	# 主要流程：
	#   1. 输出 ppp0 在线状态。
	#   2. 输出 ifconfig、路由和 pppd PID。
	#   3. 输出 monitor 最近一次状态文件。
	#   4. 如果 board-time-sync 存在，则输出校时状态。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   始终返回 0，便于排障时尽可能打印完整信息。
	ensure_usb_runtime_power

	if is_ppp_up; then
		log_msg "$PPP_IF 在线，本地 IP：$(get_ppp_ip)"
	else
		log_msg "$PPP_IF 未在线"
	fi

	echo "---- ifconfig $PPP_IF ----"
	ifconfig "$PPP_IF" 2>/dev/null || true
	echo "---- ip route show ----"
	ip route show
	echo "---- pppd pid ----"
	pidof pppd 2>/dev/null || echo "pppd not running"
	echo "---- 4g monitor state ----"
	if [ -f "$STATE_FILE" ]; then
		cat "$STATE_FILE"
	else
		echo "state file not found: $STATE_FILE"
	fi
	echo "---- board time ----"
	if [ -x "$TIME_SYNC_CMD" ]; then
		"$TIME_SYNC_CMD" status
	else
		echo "board-time-sync not installed"
	fi
}

test_ppp()
{
	# 函数作用：
	#   用腾讯云域名测试 DNS、HTTPS 前的网络连通性。
	#
	# 主要流程：
	#   1. 先确保默认路由可用。
	#   2. 再 ping PING_HOST 三次。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   返回 ping 的结果。
	ensure_usb_runtime_power
	ensure_default_route || return 1
	ping -c 3 "$PING_HOST"
}

monitor_loop()
{
	# 函数作用：
	#   常驻监控 SIM/PPP 状态，实现拔卡后低频等待、插回后快速重连。
	#
	# 主要流程：
	#   1. 在线时只低频检查 ppp0，不抢 AT 串口。
	#   2. 离线时如果 pppd 残留，则先停止 pppd，释放 PPP 拨号口和 AT 查询口。
	#   3. 无卡刚发生时每 5 秒一轮；持续无卡超过默认 8 秒后切到 8 秒一轮。
	#   4. 无卡等待期间不发送 AT，只被动监听串口 URC；超时后才做一次 AT+CPIN? 兜底查询。
	#   5. 检测到 SIM READY 后立刻启动 PPP，并恢复路由和校时。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   该函数为常驻循环，正常不会返回。
	log_msg "4G PPP monitor 启动：无卡低频轮询，插回短时快速确认"
	write_state "monitor_starting" "4G PPP monitor 启动"
	enable_sim_hotplug_detection
	no_card_since=0
	last_online_sim_check=0

	while true; do
		ensure_usb_runtime_power

		if is_ppp_up && [ -n "$(get_ppp_ip)" ]; then
			no_card_since=0
			now="$(now_seconds)"
			online_elapsed="$SIM_ONLINE_SIM_CHECK_INTERVAL"
			if [ "$now" -gt 0 ] && [ "$last_online_sim_check" -gt 0 ]; then
				online_elapsed=$((now - last_online_sim_check))
			fi

			if [ "$online_elapsed" -ge "$SIM_ONLINE_SIM_CHECK_INTERVAL" ]; then
				last_online_sim_check="$now"
				online_sim_check >/dev/null 2>&1 || true
				online_sim_status="$ONLINE_SIM_STATUS"
				case "$online_sim_status" in
					no_sim|sim_error)
						log_msg "在线 SIM 健康检测发现 $online_sim_status，主动停止 pppd 并切换离线状态"
						write_state "$online_sim_status" "在线检测发现 $online_sim_status，主动断开 PPP"
						stop_ppp
						no_card_since="$(now_seconds)"
						if [ "$online_sim_status" = "sim_error" ]; then
							if try_sim_error_fast_ready; then
								no_card_since=0
								start_ppp || {
									log_msg "SIM 错误快速恢复后自动拨号失败，稍后重试"
									write_state "dial_failed" "SIM 错误快速恢复后自动拨号失败"
									sleep "$SIM_UNKNOWN_INTERVAL"
								}
								continue
							fi

							if try_sim_cfun_reinit "sim_error"; then
								if wait_for_sim_ready "$SIM_AFTER_CFUN_READY_WAIT_SECONDS"; then
									no_card_since=0
									start_ppp || {
										log_msg "CFUN 后 SIM READY 但自动拨号失败，稍后重试"
										write_state "dial_failed" "CFUN 后 SIM READY 但自动拨号失败"
										sleep "$SIM_UNKNOWN_INTERVAL"
									}
									continue
								fi
							fi
						fi
						sleep "$SIM_RECENT_NO_CARD_INTERVAL"
						continue
						;;
					ready)
						log_msg "在线 SIM 健康检测正常：$AT_TTY -> READY"
						;;
					skipped)
						log_msg "在线 SIM 健康检测跳过：没有非 $PPP_TTY 的辅助 AT 口"
						;;
					*)
						log_msg "在线 SIM 健康检测未确认：$online_sim_status，继续观察 $PPP_IF"
						;;
				esac

				if ! online_link_check; then
					log_msg "在线 4G 链路健康检测失败，主动停止 pppd 并切换离线状态"
					write_state "link_offline" "在线 ping $PING_HOST 失败，主动断开 PPP"
					stop_ppp
					no_card_since="$(now_seconds)"
					sleep "$SIM_RECENT_NO_CARD_INTERVAL"
					continue
				fi
			fi

			write_state "online" "$PPP_IF 在线，本地 IP：$(get_ppp_ip)"
			sleep "$SIM_ONLINE_SIM_CHECK_INTERVAL"
			continue
		fi

		if [ ! -c "$PPP_TTY" ] && ! find_at_tty; then
			write_state "no_tty" "未发现 $PPP_TTY，且未找到可响应 AT 的查询口"
			sleep "$WAIT_TTY_SECONDS"
			continue
		fi

		if is_pppd_running; then
			log_msg "pppd 存在但 $PPP_IF 未在线，先停止 pppd 释放 AT 串口"
			stop_ppp
			sleep 2
		fi

		sim_status="$(query_sim_status)"
		case "$sim_status" in
			ready)
				no_card_since=0
				write_state "sim_ready" "SIM READY，开始自动重拨"
				start_ppp || {
					log_msg "SIM READY 后自动拨号失败，稍后重试"
					write_state "dial_failed" "SIM READY 后自动拨号失败"
					sleep "$SIM_UNKNOWN_INTERVAL"
				}
				;;
			no_sim)
				now="$(now_seconds)"
				if [ "$no_card_since" -eq 0 ]; then
					no_card_since="$now"
				fi

				elapsed=0
				if [ "$now" -gt 0 ] && [ "$no_card_since" -gt 0 ]; then
					elapsed=$((now - no_card_since))
				fi

				if [ "$elapsed" -lt "$SIM_RECENT_NO_CARD_WINDOW_SECONDS" ]; then
					wait_interval="$SIM_RECENT_NO_CARD_INTERVAL"
				else
					wait_interval="$SIM_LONG_NO_CARD_INTERVAL"
				fi

				log_msg "SIM 未就绪或未插卡，已无卡 ${elapsed}s，本轮低频等待 ${wait_interval}s"
				write_state "no_sim" "已无卡 ${elapsed}s，下次主动查询间隔 ${wait_interval}s"

				if wait_for_sim_urc_or_timeout "$wait_interval"; then
					wait_for_sim_ready && start_ppp
				else
					if [ "$elapsed" -ge "$SIM_CFUN_AFTER_NO_CARD_SECONDS" ]; then
						try_sim_cfun_reinit "long_no_card" || true
					fi
				fi
				;;
			sim_error)
				now="$(now_seconds)"
				if [ "$no_card_since" -eq 0 ]; then
					no_card_since="$now"
				fi
				log_msg "SIM 返回错误状态：$sim_status，先轻量快速确认，失败后才按冷却策略 CFUN 兜底"
				write_state "sim_error" "SIM 返回错误状态：$sim_status"
				if try_sim_error_fast_ready; then
					no_card_since=0
					start_ppp || {
						log_msg "SIM 错误快速恢复后自动拨号失败，稍后重试"
						write_state "dial_failed" "SIM 错误快速恢复后自动拨号失败"
						sleep "$SIM_UNKNOWN_INTERVAL"
					}
					continue
				fi

				if try_sim_cfun_reinit "sim_error"; then
					if wait_for_sim_ready "$SIM_AFTER_CFUN_READY_WAIT_SECONDS"; then
						no_card_since=0
						start_ppp || {
							log_msg "CFUN 后 SIM READY 但自动拨号失败，稍后重试"
							write_state "dial_failed" "CFUN 后 SIM READY 但自动拨号失败"
							sleep "$SIM_UNKNOWN_INTERVAL"
						}
						continue
					fi
				fi

				sleep "$SIM_LONG_NO_CARD_INTERVAL"
				;;
			pin_required)
				log_msg "SIM 需要 PIN/PUK，monitor 不会继续拨号"
				write_state "sim_pin_required" "SIM 需要 PIN/PUK"
				sleep "$SIM_LONG_NO_CARD_INTERVAL"
				;;
			tty_missing)
				write_state "no_tty" "未发现 $PPP_TTY"
				sleep "$WAIT_TTY_SECONDS"
				;;
			*)
				log_msg "SIM 状态未知：$sim_status，${SIM_UNKNOWN_INTERVAL}s 后重试"
				write_state "sim_unknown" "SIM 状态未知：$sim_status"
				sleep "$SIM_UNKNOWN_INTERVAL"
				;;
		esac
	done
}

monitor_start()
{
	# 函数作用：
	#   后台启动 SIM/PPP 监控守护进程。
	#
	# 主要流程：
	#   1. 如果 PID 文件中的进程仍存在，则不重复启动。
	#   2. 使用 nohup 后台执行本脚本 monitor 子命令。
	#   3. 写入 monitor PID，便于 stop/status 管理。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   0 表示 monitor 已运行或启动成功。
	if [ -f "$MONITOR_PID_FILE" ]; then
		monitor_pid="$(cat "$MONITOR_PID_FILE" 2>/dev/null || true)"
		if [ -n "$monitor_pid" ] && kill -0 "$monitor_pid" 2>/dev/null; then
			log_msg "4G PPP monitor 已在运行，PID=$monitor_pid"
			return 0
		fi
	fi

	# 后台 monitor 需要继承当前拨号参数和检测频率；显式 export 可避免不同 BusyBox shell
	# 对“环境变量导入后再次赋值是否保留导出属性”的处理差异。
	export PPP_IF PPP_DIR PPP_ON PPP_TTY AT_TTY AT_TTY_CANDIDATES PPP_BAUD LOG_FILE PID_FILE STATE_FILE MONITOR_PID_FILE CFUN_STAMP_FILE SIM_ERROR_FAST_STAMP_FILE
	export WAIT_TTY_SECONDS WAIT_PPP_SECONDS PING_HOST TIME_SYNC_CMD BOARD_TIME_ZONE USB_POWER_CONTROLS
	export AT_RESPONSE_SECONDS AT_PROBE_SECONDS AT_LOCK_DIR AT_LOCK_WAIT_SECONDS AT_LOCK_STALE_SECONDS
	export SIM_PRESENT_WIRED SIM_RECENT_NO_CARD_INTERVAL SIM_RECENT_NO_CARD_WINDOW_SECONDS
	export SIM_LONG_NO_CARD_INTERVAL SIM_FAST_RETRY_SECONDS SIM_FAST_WAIT_SECONDS SIM_ONLINE_CHECK_INTERVAL SIM_ONLINE_SIM_CHECK_INTERVAL SIM_ONLINE_PING_TIMEOUT SIM_UNKNOWN_INTERVAL
	export SIM_CFUN_RECOVERY SIM_CFUN_ON_SIM_ERROR SIM_ERROR_FAST_WAIT_SECONDS SIM_ERROR_FAST_COOLDOWN_SECONDS SIM_CFUN_SIM_ERROR_COOLDOWN_SECONDS SIM_CFUN_AFTER_NO_CARD_SECONDS SIM_CFUN_COOLDOWN_SECONDS SIM_AFTER_CFUN_WAIT_SECONDS SIM_AFTER_CFUN_READY_WAIT_SECONDS

	nohup "$0" monitor > /dev/null 2>>"$LOG_FILE" < /dev/null &
	echo "$!" > "$MONITOR_PID_FILE"
	log_msg "已后台启动 4G PPP monitor，PID=$!"
	write_state "monitor_started" "后台 monitor PID=$!"
}

monitor_stop()
{
	# 函数作用：
	#   停止后台 SIM/PPP 监控守护进程。
	#
	# 主要流程：
	#   1. 读取 monitor PID 文件。
	#   2. 如果进程存在则发送 TERM。
	#   3. 删除 PID 文件并更新状态。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   0 表示停止流程完成；没有 monitor 时也视为完成。
	if [ -f "$MONITOR_PID_FILE" ]; then
		monitor_pid="$(cat "$MONITOR_PID_FILE" 2>/dev/null || true)"
		if [ -n "$monitor_pid" ] && kill -0 "$monitor_pid" 2>/dev/null; then
			kill "$monitor_pid" 2>/dev/null || true
			log_msg "已停止 4G PPP monitor，PID=$monitor_pid"
		else
			log_msg "monitor PID 文件存在，但进程已不存在"
		fi
	else
		log_msg "没有正在运行的 4G PPP monitor"
	fi

	rm -f "$MONITOR_PID_FILE"
	write_state "monitor_stopped" "4G PPP monitor 已停止"
}

start_with_monitor()
{
	# 函数作用：
	#   兼容原来的 `4g-ppp start` 开机入口，同时启动后台 SIM 热插拔恢复监控。
	#
	# 主要流程：
	#   1. 先执行一次正常拨号，保持旧的 start 语义。
	#   2. 无论本次拨号是否成功，都启动 monitor，让未插卡或后续插回 SIM 的场景可以自动恢复。
	#   3. 返回本次拨号的原始结果，避免开机日志把当前没有拨上误显示成成功。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   返回 start_ppp 的结果；monitor 启动失败会写日志，但不掩盖拨号结果。
	start_ppp
	start_rc="$?"
	monitor_start
	return "$start_rc"
}

stop_with_monitor()
{
	# 函数作用：
	#   停止后台 monitor 和当前 PPP 链路，避免用户手动 stop 后 monitor 又立刻重拨。
	#
	# 主要流程：
	#   1. 先停止 monitor，关闭自动恢复循环。
	#   2. 再停止 pppd 并清理默认路由。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   始终按 stop_ppp 的宽松语义完成；没有 monitor 或没有 pppd 都是可接受状态。
	monitor_stop
	stop_ppp
}

restart_with_monitor()
{
	# 函数作用：
	#   重新启动 PPP，并确保重启后后台 monitor 继续负责 SIM 热插拔恢复。
	#
	# 主要流程：
	#   1. 停止旧 monitor，避免重启过程中两个 monitor 同时操作串口。
	#   2. 停止旧 pppd，释放 PPP 串口。
	#   3. 等待 2 秒让 ttyUSB 和路由状态稳定。
	#   4. 执行一次拨号，并无论成功失败都启动 monitor。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   返回本次 start_ppp 的结果。
	monitor_stop
	stop_ppp
	sleep 2
	start_ppp
	start_rc="$?"
	monitor_start
	return "$start_rc"
}

usage()
{
	# 函数作用：
	#   输出脚本支持的命令，避免用户只看到模糊的参数错误。
	#
	# 主要流程：
	#   1. 打印 PPP 拨号命令。
	#   2. 打印 SIM 热插拔监控命令。
	#   3. 打印关键环境变量，方便调试检测频率。
	#
	# 参数：
	#   无。
	#
	# 返回值：
	#   始终返回 0。
	echo "Usage: $0 {start|stop|restart|status|test|sim-status|monitor|monitor-start|monitor-stop}"
	echo "SIM monitor env: SIM_RECENT_NO_CARD_INTERVAL=$SIM_RECENT_NO_CARD_INTERVAL, SIM_LONG_NO_CARD_INTERVAL=$SIM_LONG_NO_CARD_INTERVAL, SIM_FAST_RETRY_SECONDS=$SIM_FAST_RETRY_SECONDS, SIM_FAST_WAIT_SECONDS=$SIM_FAST_WAIT_SECONDS"
}

case "$1" in
	start)
		start_with_monitor
		;;
	stop)
		stop_with_monitor
		;;
	restart)
		restart_with_monitor
		;;
	status)
		status_ppp
		;;
	test)
		test_ppp
		;;
	sim-status)
		print_sim_status
		;;
	monitor)
		monitor_loop
		;;
	monitor-start)
		monitor_start
		;;
	monitor-stop)
		monitor_stop
		;;
	*)
		usage
		exit 1
		;;
esac
